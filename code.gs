/**
 * =============================================================================
 *  CEE MOCK PORTAL — ALL-IN-ONE  (Google Apps Script + Google Sheets)
 *  Free online mock-test practice system for Medical Entrance (MBBS/BDS)
 *  exam preparation in Nepal.
 * =============================================================================
 *
 *  This single file contains the COMPLETE system:
 *    - Backend  : all server-side functions (Google Apps Script)
 *    - Database : auto-created Google Sheet tabs (Users, Attempts, Responses,
 *                 Questions, Messages) — no external database needed
 *    - Frontend : the full HTML/CSS/JS web app, embedded as a base64 string
 *                 (EMBEDDED_HTML) and served by doGet()
 *    - Email    : Google MailApp (free tier)
 *    - Fallback : 8 hardcoded questions (FALLBACK_BANK) so mocks work even
 *                 before any question is uploaded
 *
 *  HOW TO DEPLOY:
 *  1. Create a new Google Sheet (any name, e.g. "CEE Mock Portal").
 *  2. Go to Extensions → Apps Script.
 *  3. Delete the default code and paste this ENTIRE file.
 *  4. (Optional) Set the SHEET_ID constant below if you want to use a specific
 *     spreadsheet. Leave it empty ('') to use the sheet this script is bound
 *     to. If neither is available, a new spreadsheet is created automatically
 *     on first run (its ID is stored in Script Properties).
 *  5. Click Deploy → New deployment → Web app
 *       - Description: anything
 *       - Execute as: Me
 *       - Who has access: Anyone
 *     Click Deploy and authorize the requested permissions (Sheets + Mail).
 *  6. Copy the /exec URL and open it in a browser.
 *  7. Register the FIRST account as Teacher/Admin — the first account is
 *     auto-approved and becomes the administrator.
 *  8. Approve student registrations from the Teacher Dashboard (they receive
 *     an automatic email).
 *  9. Students can now register, log in (after approval) and take mock tests.
 * 10. Teachers upload questions via Bulk CSV/XLSX upload, the PDF question
 *     builder, or the single-question form. Email quota (consumer accounts):
 *     ~100 emails/day via MailApp.
 *
 *  NOTES:
 *  - All read-modify-write operations are serialized with LockService because
 *    Google Sheets is not a transactional database.
 *  - Only affected rows/cells are updated; whole tabs are never rewritten.
 *  - Scoring is computed SERVER-SIDE only (+1 / −0.25 / 0) — the client never
 *    receives correct answers during an exam. Exam start times are recorded
 *    server-side and late submissions (past duration + 2 min grace) are
 *    flagged as auto-submitted; re-submissions return the stored attempt
 *    (idempotent) instead of duplicating it.
 *  - SECURITY: only the public API functions (doGet, registerUser, loginUser,
 *    …, bulkUploadQuestions, initializeSheet, getSpreadsheet) do NOT end with
 *    an underscore — per the Apps Script docs, functions whose names end with
 *    an underscore are private and CANNOT be invoked via google.script.run by
 *    a browser client. Keep every sensitive helper underscore-suffixed.
 *  - Text written to the sheet is apostrophe-escaped when needed so Sheets
 *    never re-interprets values as formulas/dates on write.
 *  - Sessions last 24 hours; each account is locked to the first device
 *    (browser localStorage deviceId) it logs in from. Teachers can reset the
 *    binding from the dashboard.
 *  - EXTRAS: custom Practice sessions (subject + difficulty filter, length,
 *    timed/untimed, negative-marking toggle, instant feedback) alongside the
 *    full mock — now composed at the OFFICIAL MECEE-BL 2026 subject ratio
 *    (Zoology 40 : Botany 40 : Chemistry 50 : Physics 50 : MAT 20 out of 200)
 *    and paced at the official 54 s per question (200 Q / 3 h); student
 *    analytics (score trend + subject & unit-level topic accuracy); a student
 *    leaderboard; change-password; question editing; login rate limiting via
 *    CacheService; per-question difficulty metadata (easy/medium/hard) with
 *    CEE-style weighted exam assembly (~20/60/20 within each subject); an
 *    in-app official-syllabus browser (format, per-group weightage, unit /
 *    topic-wise contents, sample questions); two-way messaging (students
 *    write their teacher; teacher replies reach the student's in-app inbox
 *    AND email); bulk-upload dry-run validation; printable per-student
 *    progress reports; and the MODEL EXAM OF THE DAY — a daily all-class
 *    exam auto-assembled from the question bank at the official blueprint
 *    ratio. A teacher generates it once (usually the day before); the SAME
 *    fixed question set in the SAME order runs the WHOLE day for every
 *    student (one attempt each, full +1/−0.25 CEE marking, daily
 *    leaderboard + rank). Optional autopilot installs a time-driven
 *    trigger that generates tomorrow's set automatically every evening, so
 *    the system chooses fresh questions from the bank daily.
 *  - Requires the V8 runtime (the default for new Apps Script projects).
 * =============================================================================
 */

/* ============================== CONFIGURATION ============================== */

/** Optional: paste a specific spreadsheet ID to store data there.
 *  Leave '' to use the spreadsheet this script is attached to. */
var SHEET_ID = '';

var APP_NAME = 'CEE Mock Portal';
/* Official MECEE-BL 2026 exam blueprint (Group I weightage out of 200):
 * Zoology 40, Botany 40, Chemistry 50, Physics 50, MAT 20. Full mocks are
 * composed proportionally to this ratio. */
var BLUEPRINT_RATIO = [['Zoology', 40], ['Botany', 40], ['Chemistry', 50], ['Physics', 50], ['MAT', 20]];
/* Official pacing: 200 questions in 3 hours = 54 seconds per question.
 * Mock duration = question count x 54 s (minimum MIN_EXAM_MINUTES). */
var SECONDS_PER_QUESTION = 54;
var MIN_EXAM_MINUTES = 10;
var EXAM_DURATION_MINUTES = 60;   /* safety fallback only (missing meta)  */
var QUESTIONS_PER_EXAM = 20;      /* questions per mock (or bank size)   */
var SESSION_HOURS = 24;           /* session token lifetime              */
var MAX_QUESTIONS_RETURNED = 1000;/* cap for getAllQuestions             */

var EXAM_GRACE_MS = 120000;     /* grace period after the timer expires    */
var MAX_IMAGE_CHARS = 48000;   /* Sheets cell-safe image size (data URI)  */
var LOGIN_MAX_FAILS = 5;       /* failed logins before a temporary lock   */
var LOGIN_LOCK_SECONDS = 120;  /* duration of that lock                  */
var MODEL_AUTO_HOUR = 20;      /* default autopilot hour (evening, before the exam day) */
var MODEL_DEFAULT_COUNT = 20;  /* default questions in a daily model exam */
var MODEL_HISTORY_DAYS = 7;    /* days of daily-exam history returned     */

