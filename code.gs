function sendMailSafe_(to, subject, htmlBody) {
  try {
    if (!to) return false;
    if (MailApp.getRemainingDailyQuota() <= 0) {
      console.log('Mail quota exhausted — skipping email to ' + to);
      return false;
    }
    MailApp.sendEmail({ to: to, subject: subject, htmlBody: htmlBody, name: APP_NAME });
    return true;
  } catch (err) {
    console.log('Mail failed (' + to + '): ' + err);
    return false;
  }
}

