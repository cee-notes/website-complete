  { section: 'MAT', topic: 'A1', question: 'Rita goes 30 km towards North from a fixed point, then after turning to her right she goes 20 km. After this she goes 30 km after turning to her right. How far and in what direction is she from her starting point?', A: '10 km west', B: '15 km east', C: '20 km east', D: '30 km west', answer: 'C', explanation: '30 km North + 20 km East + 30 km South brings her 20 km East of the starting point. (Official MECEE-BL MAT sample question.)', image: '', difficulty: 'medium' },
  { section: 'MAT', topic: 'A2', question: 'The length and breadth of a rectangle are increased by 15% and 25% respectively. What is the percentage increase in the area of the rectangle?', A: '20%', B: '30%', C: '40%', D: '44%', answer: 'D', explanation: 'New area factor = 1.15 \u00D7 1.25 = 1.4375, so the area increases by 43.75% \u2248 44%. (Official MECEE-BL MAT sample question.)', image: '', difficulty: 'medium' },
  { section: 'MAT', topic: 'A3', question: 'Look at this series: 53, 53, 40, 40, 27, 27, \u2026 Which pair of numbers should come next?', A: '12', B: '14', C: '27', D: '53', answer: 'B', explanation: 'Each value appears twice, then drops by 13: 27 \u2212 13 = 14, so the next pair is 14, 14. (Official MECEE-BL MAT sample question.)', image: '', difficulty: 'medium' }
];

/* ============================== SHEET SCHEMA =============================== */

var TAB_USERS = 'Users';
var TAB_ATTEMPTS = 'Attempts';
var TAB_RESPONSES = 'Responses';
var TAB_QUESTIONS = 'Questions';
var TAB_MESSAGES = 'Messages';
var TAB_DAILY = 'DailyExams';

var HEADERS = {};
HEADERS[TAB_USERS] = ['id', 'name', 'email', 'username', 'password', 'role', 'status', 'deviceId', 'sessionToken', 'sessionExpiry', 'createdAt'];
HEADERS[TAB_ATTEMPTS] = ['timestamp', 'userId', 'userName', 'email', 'score', 'totalQuestions', 'correct', 'wrong', 'skipped', 'accuracy', 'section', 'detailCount'];
HEADERS[TAB_RESPONSES] = ['timestamp', 'userId', 'itemIndex', 'question', 'topic', 'chosenLetter', 'correctLetter', 'wasCorrect', 'explanation', 'image'];
HEADERS[TAB_QUESTIONS] = ['section', 'topic', 'question', 'A', 'B', 'C', 'D', 'answer', 'explanation', 'image', 'difficulty'];
HEADERS[TAB_MESSAGES] = ['timestamp', 'fromId', 'fromName', 'fromEmail', 'fromRole', 'toId', 'toRole', 'subject', 'body', 'readAt'];
/* One row per calendar date. `questions` holds a JSON array of the exact
 * question texts in the fixed order every student gets that day; everything
 * else (options, answer, explanation, image, difficulty) is resolved from the
 * Questions tab at serve/scoring time so teacher edits keep propagating. */
HEADERS[TAB_DAILY] = ['date', 'status', 'questionCount', 'generatedBy', 'generatedAt', 'salt', 'auto', 'questions'];

/* ================================ WEB ENTRY ================================ */

/**
 * Serves the embedded frontend. The HTML is stored base64-encoded in
 * EMBEDDED_HTML, decoded here and returned as an HtmlService page.
 */
function doGet() {
  try {
    initializeSheet();
  } catch (err) {
    console.log('initializeSheet failed (will retry on API calls): ' + err);
  }
  var html = Utilities.newBlob(Utilities.base64Decode(EMBEDDED_HTML)).getDataAsString();
  return HtmlService.createHtmlOutput(html)
    .setTitle(APP_NAME)
    .addMetaTag('viewport', 'width=device-width, initial-scale=1');
}

/** Public helper (also called by doGet): creates tabs + seeds fallback bank. */
function initializeSheet() {
  var ss = getSpreadsheet_();
  ensureSheets_(ss, false);
}

/* ============================ SPREADSHEET CORE ============================= */

var CACHED_SS_ = null;

/** Returns the database spreadsheet (bound sheet, SHEET_ID, or auto-created). */
function getSpreadsheet_() {
  if (CACHED_SS_) return CACHED_SS_;
  if (SHEET_ID) {
    CACHED_SS_ = SpreadsheetApp.openById(SHEET_ID);
    return CACHED_SS_;
  }
  CACHED_SS_ = SpreadsheetApp.getActiveSpreadsheet();
  if (!CACHED_SS_) {
    var props = PropertiesService.getScriptProperties();
    var stored = props.getProperty('CEE_DB_SHEET_ID');
    if (stored) {
      try { CACHED_SS_ = SpreadsheetApp.openById(stored); } catch (e) { CACHED_SS_ = null; }
    }
    if (!CACHED_SS_) {
      CACHED_SS_ = SpreadsheetApp.create(APP_NAME + ' — Database');
      props.setProperty('CEE_DB_SHEET_ID', CACHED_SS_.getId());
    }
  }
  return CACHED_SS_;
}

/** Creates any missing tabs with headers, self-heals missing columns (new
 *  columns are APPENDED so existing data keeps its order) and seeds the
 *  fallback bank once. Version bumps: v2 added the Messages tab and the
 *  Questions.difficulty column; v3 adds the DailyExams tab (model exam of
 *  the day) to existing deployments. */
function ensureSheets_(ss, force) {
  var props = PropertiesService.getScriptProperties();
  if (!force && props.getProperty('CEE_TABS_READY') === 'v3') return;
  Object.keys(HEADERS).forEach(function (name) {
    var sh = ss.getSheetByName(name);
    var headers = HEADERS[name];
    if (!sh) {
      sh = ss.insertSheet(name);
      sh.getRange(1, 1, 1, headers.length).setValues([headers]);
      sh.setFrozenRows(1);
    } else {
      var existing = sh.getRange(1, 1, 1, Math.max(1, sh.getLastColumn())).getValues()[0]
        .map(function (x) { return String(x).trim(); });
      var missing = headers.filter(function (h) { return existing.indexOf(h) < 0; });
      if (sh.getLastRow() === 0) {
        sh.getRange(1, 1, 1, headers.length).setValues([headers]);
        sh.setFrozenRows(1);
      } else if (missing.length) {
        /* append the new column headers at the end (order-safe migration) */
        sh.getRange(1, existing.length + 1, 1, missing.length).setValues([missing]);
        if (name === TAB_QUESTIONS && missing.indexOf('difficulty') >= 0) {
          /* backfill migrated rows with the default difficulty */
          var rows = Math.max(0, sh.getLastRow() - 1);
          if (rows > 0) sh.getRange(2, existing.length + 1, rows, 1).setValue('medium');
        }
      }
    }
  });
  var q = ss.getSheetByName(TAB_QUESTIONS);
  if (q && q.getLastRow() <= 1) {
    seedFallbackBank_(q);
  }
  props.setProperty('CEE_TABS_READY', 'v3');
}

/** Writes FALLBACK_BANK rows into the Questions sheet (block append). */
function seedFallbackBank_(sh) {
  var rows = FALLBACK_BANK.map(function (q) {
    return [q.section, q.topic, safeText_(q.question), q.A, q.B, q.C, q.D, q.answer, q.explanation, q.image, q.difficulty || 'medium'];
  });
  sh.getRange(sh.getLastRow() + 1, 1, rows.length, rows[0].length).setValues(rows);
}

/** Normalizes any difficulty input to easy/medium/hard (default medium). */
function normalizeDifficulty_(v) {
  var d = norm_(v);
  if (d === 'e' || d === 'easy') return 'easy';
  if (d === 'h' || d === 'hard' || d === 'difficult') return 'hard';
  return 'medium';
}

/** Public per the project brief; safe metadata-only accessor. (The real
 *  spreadsheet object is only handled by the private getSpreadsheet_().) */
function getSpreadsheet() {
  var ss = getSpreadsheet_();
  return { id: ss.getId(), name: ss.getName() };
}

/** Gets a sheet by tab name, self-healing if a tab was deleted. */
function getSheet_(name) {
  var ss = getSpreadsheet_();
  var sh = ss.getSheetByName(name);
  if (!sh) {
    ensureSheets_(ss, true);
    sh = ss.getSheetByName(name);
  }
  return sh;
}

/** Reads a whole tab into objects ({ _row: sheetRow, <header>: value }). */
function readTab_(name) {
  var sh = getSheet_(name);
  var values = sh.getDataRange().getValues();
  var headers = HEADERS[name];
  var out = [];
  for (var r = 1; r < values.length; r++) {
    if (String(values[r][0]) === '') continue;
    var obj = { _row: r + 1 };
    for (var c = 0; c < headers.length; c++) {
      obj[headers[c]] = values[r][c] === null ? '' : values[r][c];
    }
    out.push(obj);
  }
  return out;
}

/** Updates ONE cell of one row (never rewrites the whole tab). */
function setCell_(name, row, header, value) {
  var col = HEADERS[name].indexOf(header) + 1;
  if (col < 1) throw new Error('Unknown column ' + header);
  getSheet_(name).getRange(row, col).setValue(value);
}

/** Serializes a critical section using the script lock. */
function withLock_(fn) {
  var lock = LockService.getScriptLock();
  if (!lock.tryLock(20000)) {
    throw new Error('BUSY:The server is busy processing another request. Please try again in a moment.');
  }
  try {
    return fn();
  } finally {
    lock.releaseLock();
  }
}

/* ================================ HELPERS ================================== */

function norm_(s) { return String(s == null ? '' : s).trim().toLowerCase(); }
function num_(v) { var n = Number(v); return isNaN(n) ? 0 : n; }

function escapeHtml_(s) {
  return String(s == null ? '' : s)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}

function fmtScore_(v) {
  var n = Math.round(num_(v) * 100) / 100;
  return n.toFixed(2).replace(/\.00$/, '').replace(/(\.\d)0$/, '$1');
}

/** Forces a value to be stored as plain TEXT in Sheets (never parsed as a
 *  formula or date). Applies the leading-apostrophe escape only when needed. */
function safeText_(v) {
  var s = String(v == null ? '' : v);
  if (s.charAt(0) === '=' || s.charAt(0) === '+') return "'" + s;
  return s;
}

/** Always-stored-as-text timestamp cell value (leading apostrophe marker). */
function tsCell_(ts) { return "'" + ts; }

/** SHA-256 password hash (server-side only). */
function hashPassword(pw) {
  var bytes = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, String(pw), Utilities.Charset.UTF_8);
  return bytes.map(function (b) { return ('0' + (b & 0xFF).toString(16)).slice(-2); }).join('');
}

/** Pure random shuffle (Fisher-Yates). */
function shuffleArray(arr) {
  var a = arr.slice();
  for (var i = a.length - 1; i > 0; i--) {
    var j = Math.floor(Math.random() * (i + 1));
    var t = a[i]; a[i] = a[j]; a[j] = t;
  }
  return a;
}

/** Deterministic seeded PRNG (mulberry32). */
function mulberry32_(seed) {
  var a = seed >>> 0;
  return function () {
    a |= 0; a = (a + 0x6D2B79F5) | 0;
    var t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

/** Deterministic shuffle from a string seed (FNV-1a hash + Fisher-Yates). */
function seededShuffle_(arr, seedStr) {
  var h = 2166136261;
  for (var i = 0; i < seedStr.length; i++) {
    h ^= seedStr.charCodeAt(i);
    h = Math.imul(h, 16777619);
  }
  var rnd = mulberry32_(h >>> 0);
  var a = arr.slice();
  for (var k = a.length - 1; k > 0; k--) {
    var j = Math.floor(rnd() * (k + 1));
    var t = a[k]; a[k] = a[j]; a[j] = t;
  }
  return a;
}

/** Normalizes client-provided exam options. Anything that is not a practice
 *  request is treated as the standard full mock. */
function normalizeExamOptions_(options) {
  var o = options || {};
  if (o.mode !== 'practice') return { mode: 'mock' };
  var subjects = [];
  if (Array.isArray(o.subjects)) {
    o.subjects.forEach(function (s) {
      var v = String(s || '').trim();
      if (v && subjects.indexOf(v) < 0) subjects.push(v);
    });
  }
  var topics = [];
  if (Array.isArray(o.topics)) {
    o.topics.forEach(function (t) {
      var v = String(t || '').trim();
      if (v && topics.indexOf(v) < 0) topics.push(v);
    });
  }
  var difficulties = [];
  if (Array.isArray(o.difficulties)) {
    o.difficulties.forEach(function (d) {
      var v = normalizeDifficulty_(d);
      if (difficulties.indexOf(v) < 0) difficulties.push(v);
    });
  }
  if (!difficulties.length) difficulties = ['easy', 'medium', 'hard'];
  return {
    mode: 'practice',
    subjects: subjects,
    topics: topics,
    difficulties: difficulties,
    count: Math.max(1, Math.min(100, num_(o.count) || 10)),
    timed: o.timed !== false,
    minutes: Math.max(1, Math.min(180, num_(o.minutes) || 15)),
    negMarking: o.negMarking !== false,
    instantFeedback: !!o.instantFeedback
  };
}

/** Canonical signature of exam options — folded into the deterministic seed
 *  so the exact same set is regenerated at submit time. */
function examOptsSignature_(opts) {
  if (!opts || opts.mode !== 'practice') return 'mock';
  return ['practice',
    (opts.subjects || []).slice().sort().join(','),
    (opts.topics || []).slice().sort().join(','),
    (opts.difficulties || ['easy', 'medium', 'hard']).slice().sort().join(','),
    num_(opts.count), opts.timed ? 1 : 0, num_(opts.minutes),
    opts.negMarking === false ? 0 : 1, opts.instantFeedback ? 1 : 0
  ].join('|');
}

/** Filters the bank to the chosen subjects / topic codes / difficulty (practice mode). */
function filterBankForPractice_(bank, opts) {
  var out = bank;
  if (opts.subjects && opts.subjects.length) {
    out = out.filter(function (q) { return opts.subjects.indexOf(String(q.section || '').trim()) >= 0; });
  }
  if (opts.topics && opts.topics.length) {
    out = out.filter(function (q) { return opts.topics.indexOf(String(q.topic || '').trim()) >= 0; });
  }
  if (opts.difficulties && opts.difficulties.length && opts.difficulties.length < 3) {
    out = out.filter(function (q) { return opts.difficulties.indexOf(normalizeDifficulty_(q.difficulty)) >= 0; });
  }
  return out;
}

/** CEE-style difficulty mix: ~20% easy / ~60% medium / ~20% hard, filled from
 *  whatever is available when a group runs short. Fully deterministic on
 *  (bank, seed) so the identical set is regenerated at submit time. */
function weightedExamPick_(bank, take, seed) {
  var groups = { easy: [], medium: [], hard: [] };
  bank.forEach(function (q) {
    var d = normalizeDifficulty_(q.difficulty);
    groups[d].push(q);
  });
  var nEasy = Math.round(take * 0.2);
  var nHard = Math.round(take * 0.2);
  var nMed = Math.max(0, take - nEasy - nHard);
  function takeFrom(key, n, subSeed) {
    var pool = seededShuffle_(groups[key], seed + '|' + subSeed);
    var picked = pool.slice(0, n);
    picked.forEach(function (q) {
      groups[key] = groups[key].filter(function (x) { return x !== q; });
    });
    return picked;
  }
  var picked = [].concat(takeFrom('easy', nEasy, 'e'), takeFrom('medium', nMed, 'm'), takeFrom('hard', nHard, 'h'));
  /* fill shortfalls from the leftover pool (any difficulty), deterministically */
  if (picked.length < take) {
    var rest = [].concat(groups.easy, groups.medium, groups.hard);
    picked = picked.concat(seededShuffle_(rest, seed + '|r').slice(0, take - picked.length));
  }
  return picked;
}

/** Official MECEE-BL 2026 blueprint assembly for full mocks: allocate the
 *  requested count across subjects at the official ratio 40:40:50:50:20
 *  (Zoology/Botany/Chemistry/Physics/MAT out of 200), using the CEE difficulty
 *  mix within each subject. Questions from legacy sections (Biology /
 *  Mathematics / anything else) are used only to fill shortfalls. Fully
 *  deterministic on (bank, seed) so the identical set is regenerated at
 *  submit time. */
function blueprintExamPick_(bank, take, seed) {
  var keys = BLUEPRINT_RATIO.map(function (p) { return p[0]; });
  var total = BLUEPRINT_RATIO.reduce(function (a, p) { return a + p[1]; }, 0);
  var pools = {}, inBlueprint = {};
  keys.forEach(function (k) { pools[k] = []; });
  bank.forEach(function (q) {
    var s = String(q.section || '').trim();
    if (pools[s]) { pools[s].push(q); inBlueprint[q] = true; }
  });
  var legacy = bank.filter(function (q) { return !inBlueprint[q]; });
  var picked = [];
  BLUEPRINT_RATIO.forEach(function (pair, i) {
    var want = Math.round(take * pair[1] / total);
    picked = picked.concat(weightedExamPick_(pools[pair[0]], want, seed + '|bp' + i));
  });
  if (picked.length > take) {
    picked = seededShuffle_(picked, seed + '|trim').slice(0, take);
  } else if (picked.length < take) {
    var leftovers = [].concat(legacy, bank.filter(function (q) { return picked.indexOf(q) < 0; }));
    picked = picked.concat(weightedExamPick_(leftovers, take - picked.length, seed + '|fill'));
  }
  return picked;
}

/** Deterministic exam set for (userId, attemptIndex, options). Regenerated
 *  identically at submit time so no server-side storage of active exams is
 *  needed. The options signature is part of the seed. Practice difficulty
 *  filters are honored; full mocks use the official blueprint ratio with the
 *  CEE-weighted difficulty mix inside each subject. */
function buildExamSet_(bank, userId, attemptIndex, opts) {
  var seed = 'exam|' + String(userId) + '|' + String(attemptIndex) + '|' + examOptsSignature_(opts);
  var take = opts && opts.mode === 'practice' ? num_(opts.count) : QUESTIONS_PER_EXAM;
  take = Math.min(take, bank.length);
  var isPractice = opts && opts.mode === 'practice';
  var diffFilter = isPractice && opts.difficulties && opts.difficulties.length && opts.difficulties.length < 3;
  var chosen = isPractice
    ? (diffFilter
      ? seededShuffle_(bank, seed).slice(0, take)
      : weightedExamPick_(bank, take, seed))
    : blueprintExamPick_(bank, take, seed);
  /* final deterministic shuffle fixes the question ORDER */
  return seededShuffle_(chosen, seed + '|order');
}

/** Questions from the sheet, or FALLBACK_BANK if the tab is empty. */
function readQuestionsWithFallback_() {
  var qs = readTab_(TAB_QUESTIONS).map(function (r) {
    return {
      section: String(r.section || ''), topic: String(r.topic || ''),
      question: String(r.question || ''), A: String(r.A || ''), B: String(r.B || ''),
      C: String(r.C || ''), D: String(r.D || ''), answer: String(r.answer || ''),
      explanation: String(r.explanation || ''), image: String(r.image || ''),
      difficulty: normalizeDifficulty_(r.difficulty)
    };
  });
  return qs.length ? qs : FALLBACK_BANK.slice();
}

/* ========================== MODEL EXAM OF THE DAY ==========================
 * A teacher (or the autopilot trigger) generates ONE fixed set per calendar
 * date — usually the evening before. Every student that day takes the SAME
 * questions in the SAME order (one attempt each, +1/−0.25/0 CEE marking),
 * which makes scores directly comparable: the daily leaderboard ranks the
 * whole class on the identical paper. Question selection is automatic from
 * the bank at the official blueprint ratio + CEE difficulty mix.            */

/** Today as a YYYY-MM-DD string in the script's time zone. */
function todayStr_() {
  return Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyy-MM-dd');
}

/** Parses a strict YYYY-MM-DD string → Date at local midnight, or null. */
function parseDateStr_(s) {
  var m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(String(s || '').trim());
  if (!m) return null;
  var d = new Date(Number(m[1]), Number(m[2]) - 1, Number(m[3]));
  if (d.getFullYear() !== Number(m[1]) || d.getMonth() !== Number(m[2]) - 1 || d.getDate() !== Number(m[3])) return null;
  return d;
}

/** dateStr + n days → YYYY-MM-DD. */
function dateStrAddDays_(dateStr, n) {
  var d = parseDateStr_(dateStr);
  if (!d) return String(dateStr || '');
  d.setDate(d.getDate() + n);
  return Utilities.formatDate(d, Session.getScriptTimeZone(), 'yyyy-MM-dd');
}

/** Normalizes a client-supplied target date to YYYY-MM-DD ('' if invalid). */
function normalizeDateStr_(s) {
  var d = parseDateStr_(s);
  return d ? Utilities.formatDate(d, Session.getScriptTimeZone(), 'yyyy-MM-dd') : '';
}

/** Reads the DailyExams tab (empty array if none yet). */
function readDailyExams_() {
  try {
    return readTab_(TAB_DAILY).map(function (r) {
      var texts = [];
      try { texts = JSON.parse(String(r.questions || '[]')); } catch (e) { texts = []; }
      if (!Array.isArray(texts)) texts = [];
      return {
        _row: r._row, date: String(r.date || ''), status: String(r.status || ''),
        questionCount: num_(r.questionCount), generatedBy: String(r.generatedBy || ''),
        generatedAt: String(r.generatedAt || ''), salt: num_(r.salt), auto: String(r.auto) === 'true',
        texts: texts
      };
    });
  } catch (e) {
    return [];
  }
}

/** Finds the daily-exam row for a date. */
function findDailyRow_(rows, dateStr) {
  var hit = null;
  rows.forEach(function (r) { if (r.date === String(dateStr) && !hit) hit = r; });
  return hit;
}

/** All attempts for one date's model exam (section 'MODEL|<date>|…'). */
function modelAttemptsForDate_(attempts, dateStr) {
  var prefix = 'MODEL|' + dateStr + '|';
  var start = 'MODEL|' + dateStr;
  return attempts.filter(function (a) {
    var s = String(a.section || '');
    return s === start || s.indexOf(prefix) === 0;
  });
}

/** Resolves a stored row's question texts against the CURRENT bank, keeping
 *  the fixed order. Deleted questions drop out (missing count returned). */
function resolveModelSet_(bank, row) {
  var byText = {};
  bank.forEach(function (q) {
    var k = norm_(q.question);
    if (!(k in byText)) byText[k] = q;
  });
  var out = [];
  row.texts.forEach(function (t) {
    var q = byText[norm_(t)];
    if (q) out.push(q);
  });
  return { set: out, missing: row.texts.length - out.length };
}

/** Daily leaderboard rows (identical paper → scores comparable). */
function dailyLeaderboardRows_(modelAttempts, users, meId) {
  var usersById = {};
  users.forEach(function (u) { usersById[String(u.id)] = u; });
  var rows = modelAttempts.map(function (a) {
    var u = usersById[String(a.userId)] || {};
    return {
      userId: String(a.userId), name: String(u.name || a.userName || 'Student'),
      score: num_(a.score), total: num_(a.totalQuestions), accuracy: num_(a.accuracy),
      submittedAt: String(a.timestamp || ''), isMe: String(a.userId) === String(meId)
    };
  });
  rows.sort(function (x, y) {
    return y.score - x.score || y.accuracy - x.accuracy ||
      (x.submittedAt < y.submittedAt ? -1 : x.submittedAt > y.submittedAt ? 1 : 0);
  });
  rows.forEach(function (r, i) { r.rank = i + 1; });
  return rows;
}

/** Teacher-facing preview of a stored row (answers included — teachers
 *  curate the bank, so the key is not a secret to them). */
function dailyPreviewItems_(bank, row) {
  var res = resolveModelSet_(bank, row);
  return res.set.map(function (q, i) {
    return {
      n: i + 1, section: q.section, topic: q.topic, question: q.question,
      A: q.A, B: q.B, C: q.C, D: q.D, answer: String(q.answer || '').toUpperCase(),
      difficulty: normalizeDifficulty_(q.difficulty), image: q.image
    };
  });
}

/** Question texts locked inside today's or future ready model exams —
 *  editing/deleting these mid-flight would corrupt in-progress exams. */
function modelLockedTexts_() {
  var locked = {};
  var today = todayStr_();
  readDailyExams_().forEach(function (r) {
    if (r.status !== 'ready' || !r.date || r.date < today) return;
    r.texts.forEach(function (t) { locked[norm_(t)] = true; });
  });
  return locked;
}

/** Writes (or replaces) the DailyExams row for a date. Must run inside the
 *  script lock. Returns the stored texts. */
function writeDailyRow_(dateStr, byName, count, auto, prevRow) {
  var bank = readQuestionsWithFallback_();
  var salt = prevRow ? num_(prevRow.salt) + 1 : 0;
  var take = Math.max(1, Math.min(count || MODEL_DEFAULT_COUNT, bank.length));
  var picked = blueprintExamPick_(bank, take, 'model|' + dateStr + '|' + salt);
  var texts = picked.map(function (q) { return q.question; });
  var sh = getSheet_(TAB_DAILY);
  var vals = [
    safeText_(dateStr), 'ready', texts.length, safeText_(byName),
    safeText_(new Date().toISOString()), salt, auto ? 'true' : 'false', safeText_(JSON.stringify(texts))
  ];
  if (prevRow) {
    sh.getRange(prevRow._row, 1, 1, vals.length).setValues([vals]);
  } else {
    sh.appendRow(vals);
  }
  return texts;
}

