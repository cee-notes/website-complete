/* ============================= AUTH & SESSIONS ============================= */

/**
 * Registers a new user. The FIRST account ever is auto-approved and forced to
 * the teacher/admin role; everyone else starts as 'pending' and cannot log in
 * until a teacher approves them. Admins are emailed about pending users.
 * @param {Object} data {name, email, username, password, role}
 */
function registerUser(data) {
  if (!data) throw new Error('Missing registration data.');
  var name = String(data.name || '').trim();
  var email = String(data.email || '').trim().toLowerCase();
  var username = String(data.username || '').trim() || email.split('@')[0];
  var password = String(data.password || '');
  var role = (data.role === 'teacher') ? 'teacher' : 'student';
  if (name.length < 2) throw new Error('Please enter your full name.');
  if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) throw new Error('Please enter a valid email address.');
  if (password.length < 6) throw new Error('Password must be at least 6 characters.');

  var result = withLock_(function () {
    var ss = getSpreadsheet_();
    ensureSheets_(ss, false);
    var users = readTab_(TAB_USERS);
    var emailTaken = users.some(function (u) { return String(u.email).toLowerCase() === email; });
    var nameTaken = users.some(function (u) { return norm_(u.username) === norm_(username); });
    if (emailTaken) throw new Error('An account with this email already exists.');
    if (nameTaken) throw new Error('This username is already taken.');
    var isFirst = users.length === 0;
    var status = isFirst ? 'approved' : 'pending';
    var finalRole = isFirst ? 'teacher' : role;
    var id = 'U' + (1000 + users.length + 1) + '-' + Utilities.getUuid().slice(0, 4);
    getSheet_(TAB_USERS).appendRow([
      id, safeText_(name), safeText_(email), safeText_(username), hashPassword(password), finalRole, status,
      '', '', '', tsCell_(new Date().toISOString())
    ]);
    return { isFirst: isFirst, status: status, finalRole: finalRole, name: name, email: email, requestedRole: role };
  });

  /* Emails (outside the lock so we never hold it while talking to Gmail). */
  if (result.isFirst) {
    sendMailSafe_(result.email, APP_NAME + ' — You are the Administrator', buildFirstAdminEmail_(result.name));
  } else {
    var admins = readTab_(TAB_USERS)
      .filter(function (u) { return u.role === 'teacher' && u.status === 'approved' && String(u.email).toLowerCase() !== email; })
      .map(function (u) { return String(u.email); });
    admins.forEach(function (a) {
      sendMailSafe_(a, APP_NAME + ' — New registration pending approval', buildPendingEmail_(result));
    });
  }

  return {
    success: true,
    isFirst: result.isFirst,
    message: result.isFirst
      ? 'Welcome! You are the first user — auto-approved as the administrator (Teacher). You can now log in.'
      : 'Registration successful! Your account is pending approval. A teacher/admin will review it and email you.'
  };
}

/**
 * Logs a user in. Enforces: approval status, password, and the one-device
 * lock (first login binds the account to that device's localStorage id).
 * Issues a session token valid for SESSION_HOURS (24h).
 * @param {string} email
 * @param {string} password
 * @param {string} deviceId  browser-generated device fingerprint
 */
function loginUser(email, password, deviceId) {
  var em = String(email || '').trim().toLowerCase();
  var device = String(deviceId || '');
  /* simple brute-force guard (CacheService, shared across executions).
   * The counter is read + written under the lock so concurrent login
   * attempts cannot race it. */
  var cache = CacheService.getScriptCache();
  var failKey = 'CEE_FAILS_' + em;
  return withLock_(function () {
    var ss = getSpreadsheet_();
    ensureSheets_(ss, false);
    var users = readTab_(TAB_USERS);
    var u = null;
    users.forEach(function (x) { if (String(x.email).toLowerCase() === em) u = x; });
    var fails = num_(cache.get(failKey));
    if (fails >= LOGIN_MAX_FAILS) {
      throw new Error('TOO_MANY_ATTEMPTS:Too many failed login attempts. Please wait a couple of minutes and try again.');
    }
    if (!u) throw new Error('No account found for this email. Please register first.');
    if (u.status === 'pending') throw new Error('ACCOUNT_PENDING:Your account is awaiting approval by a teacher/admin. You will be emailed once reviewed.');
    if (u.status === 'rejected') throw new Error('ACCOUNT_REJECTED:Your registration was rejected. Please contact a teacher/admin.');
    if (String(u.password) !== hashPassword(password)) {
      cache.put(failKey, String(fails + 1), LOGIN_LOCK_SECONDS);
      throw new Error('Incorrect password. Please try again.');
    }
    cache.remove(failKey);
    if (u.deviceId && String(u.deviceId) !== device) {
      throw new Error('DEVICE_LOCKED:This account is already signed in on another device. Ask a teacher/admin to reset your device binding.');
    }
    var token = Utilities.getUuid();
    var expiry = Date.now() + SESSION_HOURS * 3600000;
    if (!u.deviceId) setCell_(TAB_USERS, u._row, 'deviceId', device);
    setCell_(TAB_USERS, u._row, 'sessionToken', token);
    setCell_(TAB_USERS, u._row, 'sessionExpiry', expiry);
    return {
      id: String(u.id), name: String(u.name), email: String(u.email),
      username: String(u.username || ''), role: String(u.role),
      token: token, expiresAt: expiry
    };
  });
}

/** Validates a session token; throws SESSION_* errors otherwise. */
function requireSession_(userId, token, role) {
  var users = readTab_(TAB_USERS);
  var u = null;
  users.forEach(function (x) { if (String(x.id) === String(userId)) u = x; });
  if (!u) throw new Error('SESSION_INVALID:Please log in again.');
  if (String(u.sessionToken || '') !== String(token || '')) throw new Error('SESSION_INVALID:Please log in again.');
  if (Date.now() > num_(u.sessionExpiry)) throw new Error('SESSION_EXPIRED:Your 24-hour session has expired. Log in again.');
  if (u.status !== 'approved') throw new Error('SESSION_INVALID:Account is not approved.');
  if (role && String(u.role) !== role) throw new Error('FORBIDDEN:This action requires a teacher account.');
  return u;
}

/** Clears the session token (client logout). */
function logoutUser(userId, token) {
  try {
    var u = requireSession_(userId, token);
    setCell_(TAB_USERS, u._row, 'sessionToken', '');
    setCell_(TAB_USERS, u._row, 'sessionExpiry', 0);
  } catch (e) { /* session already invalid — nothing to clear */ }
  return { success: true };
}

/* ============================== APPROVAL FLOW ============================== */

/** Teacher-only: approves a pending user + sends them a confirmation email. */
function approveUser(targetUserId, adminUserId, adminToken) {
  var admin = requireSession_(adminUserId, adminToken, 'teacher');
  var info = withLock_(function () {
    var users = readTab_(TAB_USERS);
    var t = null;
    users.forEach(function (x) { if (String(x.id) === String(targetUserId)) t = x; });
    if (!t) throw new Error('User not found.');
    if (t.status !== 'pending') throw new Error('This user is not pending (status: ' + t.status + ').');
    setCell_(TAB_USERS, t._row, 'status', 'approved');
    return { name: String(t.name), email: String(t.email) };
  });
  sendMailSafe_(info.email, APP_NAME + ' — Your account is approved', buildApprovedEmail_(info.name));
  console.log('User ' + targetUserId + ' approved by ' + admin.email);
  return { success: true, message: info.name + ' approved and notified by email.' };
}

/** Teacher-only: rejects a pending user + sends them a notification email. */
function rejectUser(targetUserId, adminUserId, adminToken) {
  requireSession_(adminUserId, adminToken, 'teacher');
  var info = withLock_(function () {
    var users = readTab_(TAB_USERS);
    var t = null;
    users.forEach(function (x) { if (String(x.id) === String(targetUserId)) t = x; });
    if (!t) throw new Error('User not found.');
    if (t.status !== 'pending') throw new Error('This user is not pending (status: ' + t.status + ').');
    setCell_(TAB_USERS, t._row, 'status', 'rejected');
    return { name: String(t.name), email: String(t.email) };
  });
  sendMailSafe_(info.email, APP_NAME + ' — Registration update', buildRejectedEmail_(info.name));
  return { success: true, message: info.name + ' rejected and notified by email.' };
}

/** Teacher-only: clears a user's device binding + session (one-device lock reset). */
function resetDevice(targetUserId, adminUserId, adminToken) {
  requireSession_(adminUserId, adminToken, 'teacher');
  return withLock_(function () {
    var users = readTab_(TAB_USERS);
    var t = null;
    users.forEach(function (x) { if (String(x.id) === String(targetUserId)) t = x; });
    if (!t) throw new Error('User not found.');
    setCell_(TAB_USERS, t._row, 'deviceId', '');
    setCell_(TAB_USERS, t._row, 'sessionToken', '');
    setCell_(TAB_USERS, t._row, 'sessionExpiry', 0);
    return { success: true, message: 'Device binding reset for ' + t.name + '. They can log in from a new device now.' };
  });
}

/* ================================ EXAM ENGINE ============================== */

/**
 * Starts an exam. Called with no options (or mode !== 'practice') it returns
 * the standard full mock; with {mode:'practice', …} it returns a custom
 * practice session. The question set is deterministic per
 * (userId, attemptIndex, options) and returned WITHOUT answers — except in
 * practice mode with instantFeedback, where the correct letter + explanation
 * are included on purpose so the client can reveal them after each answer
 * (scoring is still computed server-side at submit).
 * The start time, duration and options are stored server-side (Script
 * Properties) for late-submission detection and authoritative scoring.
 * @param {string} userId
 * @param {string} sessionToken
 * @param {Object} [options] {mode, subjects, topics, count, timed, minutes,
 *                            negMarking, instantFeedback}
 */
function startMockExam(userId, sessionToken, options) {
  var user = requireSession_(userId, sessionToken);
  var opts = normalizeExamOptions_(options);
  var bank = readQuestionsWithFallback_();
  if (opts.mode === 'practice') {
    bank = filterBankForPractice_(bank, opts);
    if (!bank.length) {
      throw new Error('No questions match your practice filters. Try different subjects, or ask a teacher to add questions to the bank.');
    }
  }
  var attemptIndex = readTab_(TAB_ATTEMPTS).filter(function (a) {
    return String(a.userId) === String(user.id);
  }).length;
  var set = buildExamSet_(bank, user.id, attemptIndex, opts);
  /* Mock duration mirrors the official MECEE-BL pacing: 200 questions in
   * 3 hours = 54 s per question (minimum MIN_EXAM_MINUTES). */
  var durationMs = opts.mode === 'practice'
    ? (opts.timed ? opts.minutes * 60000 : 0)
    : Math.max(MIN_EXAM_MINUTES, Math.round(set.length * SECONDS_PER_QUESTION / 60)) * 60000;
  /* record the server-side start time + options for late-submission
   * detection and authoritative option recovery at submit time. The meta is
   * keyed to this attemptIndex so a stale meta can never be applied to a
   * different submission. */
  var props = PropertiesService.getScriptProperties();
  props.setProperty('CEE_EXAM_META_' + String(user.id), JSON.stringify({ start: Date.now(), dur: durationMs, opts: opts, attemptIndex: attemptIndex }));
  props.deleteProperty('CEE_EXAM_START_' + String(user.id)); /* legacy key */
  var reveal = opts.mode === 'practice' && opts.instantFeedback;
  var questions = set.map(function (q) {
    var item = {
      section: q.section, topic: q.topic, question: q.question,
      A: q.A, B: q.B, C: q.C, D: q.D, image: q.image,
      difficulty: normalizeDifficulty_(q.difficulty)
    };
    if (reveal) {
      item.answer = String(q.answer || '').toUpperCase();
      item.explanation = q.explanation || '';
    }
    return item;
  });
  return {
    questions: questions,
    questionCount: questions.length,
    durationMinutes: Math.round(durationMs / 60000),
    attemptIndex: attemptIndex,
    startedAt: new Date().toISOString(),
    mode: opts.mode,
    opts: opts
  };
}

function scoreItem_(q, idx, chosen) {
  var was = 0;
  if (chosen) was = (chosen === String(q.answer || '').toUpperCase()) ? 1 : -1;
  return {
    itemIndex: idx,
    section: q.section || '',
    topic: q.topic || '',
    question: q.question,
    options: [q.A || '', q.B || '', q.C || '', q.D || ''],
    chosenLetter: chosen || '',
    correctLetter: String(q.answer || '').toUpperCase(),
    wasCorrect: was,
    explanation: q.explanation || '',
    image: q.image || '',
    difficulty: normalizeDifficulty_(q.difficulty)
  };
}

/**
 * Submits an exam (mock, practice or daily model exam). Scores are computed
 * HERE on the server: +1 correct · −0.25 wrong (0 in practice without
 * negative marking) · 0 skipped.
 * Mock/practice sets are regenerated deterministically from (userId,
 * attemptIndex, options); the daily model exam is resolved from the
 * DailyExams row the server itself recorded at startDailyExam time (the
 * SAME fixed set every student gets that day). Any answered questions
 * outside the set are still scored by text lookup so no answer is ever lost.
 * Saves one Attempts row + N Responses rows, then emails the student.
 * @param {string} userId
 * @param {string} sessionToken
 * @param {Object} examData {attemptIndex, answers:[{question,chosen}],
 *                           autoSubmitted, options}
 */
function submitExam(userId, sessionToken, examData) {
  var user = requireSession_(userId, sessionToken);
  var data = examData || {};
  var answers = Array.isArray(data.answers) ? data.answers : [];

  /* Server-side time enforcement + authoritative options. The stored exam
   * meta (start, duration, options) is keyed to the attemptIndex it was
   * started with and is consumed ONLY when the submission's attemptIndex
   * matches — a mismatched meta (e.g. a duplicate re-submission of an old
   * attempt, or a newer exam started in another tab) is left untouched and
   * the submission falls back to standard mock rules. Client-supplied
   * options are never trusted for scoring. Model-exam submissions REQUIRE a
   * matching server meta (the date + set come from the server row, so a
   * spoofed 'model' hint without a real start is rejected outright). */
  var props = PropertiesService.getScriptProperties();
  var metaKey = 'CEE_EXAM_META_' + String(user.id);
  var metaRaw = props.getProperty(metaKey);
  var meta = null;
  try { meta = metaRaw ? JSON.parse(metaRaw) : null; } catch (e) { meta = null; }
  if (!meta || num_(meta.attemptIndex) !== num_(data.attemptIndex)) {
    meta = null; /* stale/absent meta — do NOT delete it, a live exam may still need it */
  } else {
    props.deleteProperty(metaKey);
  }
  if (data.options && data.options.mode === 'model' && (!meta || !meta.opts || meta.opts.mode !== 'model')) {
    throw new Error('MODEL_NO_META:This model exam is no longer active. Open the “Model exam of the day” card on your dashboard and start it again.');
  }
  /* legacy start-only key (pre-practice-version exams) */
  var legacyStartMs = num_(props.getProperty('CEE_EXAM_START_' + String(user.id)));
  if (legacyStartMs) props.deleteProperty('CEE_EXAM_START_' + String(user.id));
  var opts = null;
  var isModel = false;
  if (meta && meta.opts) {
    if (meta.opts.mode === 'practice') opts = normalizeExamOptions_(meta.opts);
    else if (meta.opts.mode === 'model') {
      isModel = true;
      opts = { mode: 'model', date: normalizeDateStr_(meta.opts.date) };
    }
  }
  var isPractice = !!(opts && opts.mode === 'practice');
  var penalty = (isPractice && opts.negMarking === false) ? 0 : 0.25;
  var allowedMs = meta ? num_(meta.dur) : EXAM_DURATION_MINUTES * 60000;
  var startMs = meta ? num_(meta.start) : legacyStartMs;
  var late = allowedMs > 0 && startMs > 0 && (Date.now() - startMs > allowedMs + EXAM_GRACE_MS);
  var autoSubmitted = !!data.autoSubmitted || late;

  var answerMap = {};
  answers.forEach(function (a) {
    if (a && a.question) answerMap[norm_(a.question)] = String(a.chosen || '').toUpperCase().slice(0, 1);
  });

  var written = withLock_(function () {
    /* Idempotency: if this (userId, attemptIndex) was already submitted,
     * return the stored result instead of duplicating the attempt. */
    var mine = readTab_(TAB_ATTEMPTS).filter(function (a) {
      return String(a.userId) === String(user.id);
    });
    mine.sort(function (x, y) { return String(x.timestamp).localeCompare(String(y.timestamp)); });
    var idx = num_(data.attemptIndex);
    if (mine.length > idx) {
      var att = mine[idx];
      var wasModel = String(att.section || '').indexOf('MODEL|') === 0;
      var dailyDup = null;
      if (wasModel) {
        var dupDate = String(att.section || '').split('|')[1] || '';
        var allAttempts1 = readTab_(TAB_ATTEMPTS);
        var dRows = dailyLeaderboardRows_(modelAttemptsForDate_(allAttempts1, dupDate), readTab_(TAB_USERS), user.id);
        var meRow = null;
        dRows.forEach(function (r) { if (r.isMe) meRow = r; });
        dailyDup = meRow ? { date: dupDate, rank: meRow.rank, participants: dRows.length } : { date: dupDate, rank: 0, participants: dRows.length };
      }
      return {
        duplicate: true, ts: String(att.timestamp), items: buildReviewItems_(user.id, String(att.timestamp)),
        score: num_(att.score), total: num_(att.totalQuestions), correct: num_(att.correct),
        wrong: num_(att.wrong), skipped: num_(att.skipped), accuracy: num_(att.accuracy),
        userName: String(user.name), email: String(user.email), autoSubmitted: false,
        practice: String(att.section || '').indexOf('PRACTICE') === 0, negMarking: true,
        model: wasModel, modelDate: wasModel ? (String(att.section || '').split('|')[1] || '') : '',
        daily: dailyDup
      };
    }

    /* MODEL path: the fixed set comes from the DailyExams row the server
     * stored for this date — the same paper every student took that day. */
    var modelRow = null;
    var modelDateStr = '';
    if (isModel) {
      modelDateStr = opts.date;
      if (!modelDateStr || modelDateStr > todayStr_()) {
        throw new Error('MODEL_EXPIRED:This model exam is not scheduled yet. Please refresh your dashboard.');
      }
      var dailyRows = readDailyExams_();
      modelRow = findDailyRow_(dailyRows, modelDateStr);
      if (!modelRow || modelRow.status !== 'ready') {
        throw new Error('MODEL_NO_META:The model exam is no longer available. Please refresh your dashboard.');
      }
      /* one attempt per user per day (double-submit / re-entry guard) */
      var already = modelAttemptsForDate_(mine, modelDateStr);
      if (already.length) {
        var att2 = already[0];
        return {
          duplicate: true, ts: String(att2.timestamp), items: buildReviewItems_(user.id, String(att2.timestamp)),
          score: num_(att2.score), total: num_(att2.totalQuestions), correct: num_(att2.correct),
          wrong: num_(att2.wrong), skipped: num_(att2.skipped), accuracy: num_(att2.accuracy),
          userName: String(user.name), email: String(user.email), autoSubmitted: false,
          practice: false, negMarking: true, model: true, modelDate: modelDateStr,
          daily: null
        };
      }
    }

    var bank = readQuestionsWithFallback_();
    if (opts && opts.mode === 'practice') bank = filterBankForPractice_(bank, opts);
    var set = isModel ? resolveModelSet_(bank, modelRow).set : buildExamSet_(bank, user.id, data.attemptIndex, opts);
    var used = {};
    var items = [];
    set.forEach(function (q, i) {
      used[norm_(q.question)] = true;
      items.push(scoreItem_(q, i, answerMap[norm_(q.question)]));
    });
    /* resilience: include answered questions that drifted out of the set */
    var extra = items.length;
    answers.forEach(function (a) {
      var key = norm_(a && a.question || '');
      if (!key || used[key]) return;
      var q = null;
      bank.forEach(function (x) { if (norm_(x.question) === key) q = x; });
      if (!q) return;
      used[key] = true;
      items.push(scoreItem_(q, extra++, answerMap[key]));
    });

    var correct = 0, wrong = 0, skipped = 0, score = 0;
    items.forEach(function (it) {
      if (it.wasCorrect === 1) { correct++; score += 1; }
      else if (it.wasCorrect === -1) { wrong++; score -= penalty; }
      else skipped++;
    });
    score = Math.round(score * 100) / 100;
    var total = items.length;
    var accuracy = total ? Math.round((correct / total) * 1000) / 10 : 0;
    var dist = {};
    items.forEach(function (it) {
      var s = it.section || 'General';
      dist[s] = (dist[s] || 0) + 1;
    });
    var sectionStr = Object.keys(dist).map(function (k) { return k + ':' + dist[k]; }).join(' | ');
    if (isPractice) sectionStr = 'PRACTICE|' + sectionStr;
    if (isModel) sectionStr = 'MODEL|' + modelDateStr + '|' + sectionStr;
    var ts = new Date().toISOString();

    getSheet_(TAB_ATTEMPTS).appendRow([
      tsCell_(ts), String(user.id), String(user.name), String(user.email),
      score, total, correct, wrong, skipped, accuracy, sectionStr, items.length
    ]);
    if (items.length) {
      var rows = items.map(function (it) {
        return [tsCell_(ts), String(user.id), it.itemIndex, safeText_(it.question), String(it.topic || ''),
          it.chosenLetter, it.correctLetter, it.wasCorrect, safeText_(it.explanation), it.image];
      });
      var sh = getSheet_(TAB_RESPONSES);
      sh.getRange(sh.getLastRow() + 1, 1, rows.length, rows[0].length).setValues(rows);
    }
    return {
      duplicate: false, ts: ts, items: items, score: score, total: total,
      correct: correct, wrong: wrong, skipped: skipped,
      accuracy: accuracy, userName: String(user.name), email: String(user.email),
      autoSubmitted: autoSubmitted, practice: isPractice, negMarking: penalty > 0,
      model: isModel, modelDate: modelDateStr, daily: null
    };
  });

  /* Email the student their score + full breakdown (outside the lock). */
  if (!written.duplicate) {
    sendMailSafe_(written.email,
      APP_NAME + ' — ' + (written.model ? 'Model exam of the day — your result: ' : written.practice ? 'Your practice result: ' : 'Your result: ') + fmtScore_(written.score) + '/' + written.total + ' (' + written.accuracy + '%)',
      buildResultEmailHtml_(written.userName, written));
  }

  /* daily rank is computed after the write (needs the fresh attempt rows) */
  if (isModel && !written.duplicate) {
    try {
      var lbRows = dailyLeaderboardRows_(modelAttemptsForDate_(readTab_(TAB_ATTEMPTS), modelDateStr), readTab_(TAB_USERS), user.id);
      var meLb = null;
      lbRows.forEach(function (r) { if (r.isMe) meLb = r; });
      written.daily = meLb ? { date: modelDateStr, rank: meLb.rank, participants: lbRows.length } : null;
    } catch (e) { /* rank is decorative — never fail the submit for it */ }
  }

  return {
    success: true,
    duplicate: written.duplicate,
    timestamp: written.ts,
    score: written.score,
    totalQuestions: written.total,
    correct: written.correct,
    wrong: written.wrong,
    skipped: written.skipped,
    accuracy: written.accuracy,
    items: written.items,
    emailed: !written.duplicate,
    autoSubmitted: written.autoSubmitted,
    mode: written.model ? 'model' : (written.practice ? 'practice' : 'mock'),
    modelDate: written.model ? written.modelDate : '',
    daily: written.daily || null,
    negMarking: written.practice ? !!written.negMarking : true
  };
}

/* ============================== STUDENT VIEWS =============================== */

/** Attempt history + aggregate stats for the logged-in student. */
function getStudentStats(userId, sessionToken) {
  var user = requireSession_(userId, sessionToken);
  var attempts = readTab_(TAB_ATTEMPTS).filter(function (a) {
    return String(a.userId) === String(user.id);
  }).map(function (a) {
    return {
      timestamp: String(a.timestamp), score: num_(a.score), totalQuestions: num_(a.totalQuestions),
      correct: num_(a.correct), wrong: num_(a.wrong), skipped: num_(a.skipped),
      accuracy: num_(a.accuracy), section: String(a.section || '')
    };
  });
  attempts.sort(function (x, y) { return y.timestamp.localeCompare(x.timestamp); });
  var n = attempts.length;
  var stats = {
    totalAttempts: n,
    avgScore: n ? Math.round(attempts.reduce(function (s, a) { return s + a.score; }, 0) / n * 100) / 100 : 0,
    avgAccuracy: n ? Math.round(attempts.reduce(function (s, a) { return s + a.accuracy; }, 0) / n * 10) / 10 : 0,
    bestScore: n ? Math.max.apply(null, attempts.map(function (a) { return a.score; })) : 0,
    questionsSeen: attempts.reduce(function (s, a) { return s + a.totalQuestions; }, 0)
  };
  return { name: String(user.name), stats: stats, attempts: attempts.slice(0, 50) };
}

/** Builds review items for a stored attempt (used by getAttemptReview and
 *  the duplicate-submission path of submitExam). */
function buildReviewItems_(userId, key) {
  var bank = {};
  readQuestionsWithFallback_().forEach(function (q) { bank[norm_(q.question)] = q; });
  var items = readTab_(TAB_RESPONSES).filter(function (r) {
    return String(r.userId) === String(userId) && String(r.timestamp) === key;
  }).map(function (r) {
    var q = bank[norm_(r.question)] || {};
    return {
      itemIndex: num_(r.itemIndex),
      section: String(q.section || ''),
      topic: String(r.topic || ''),
      question: String(r.question),
      options: [String(q.A || ''), String(q.B || ''), String(q.C || ''), String(q.D || '')],
      chosenLetter: String(r.chosenLetter || ''),
      correctLetter: String(r.correctLetter || ''),
      wasCorrect: num_(r.wasCorrect),
      explanation: String(r.explanation || ''),
      image: String(r.image || q.image || ''),
      difficulty: normalizeDifficulty_(q.difficulty)
    };
  });
  items.sort(function (a, b) { return a.itemIndex - b.itemIndex; });
  return items;
}

/** Re-opens a saved attempt: the student's answers vs correct answers. */
function getAttemptReview(userId, sessionToken, timestamp) {
  var user = requireSession_(userId, sessionToken);
  var key = String(timestamp || '');
  var attempts = readTab_(TAB_ATTEMPTS).filter(function (a) {
    return String(a.userId) === String(user.id) && String(a.timestamp) === key;
  });
  if (!attempts.length) throw new Error('Attempt not found.');
  var att = attempts[0];
  var items = buildReviewItems_(user.id, key);
  return {
    attempt: {
      timestamp: key, score: num_(att.score), totalQuestions: num_(att.totalQuestions),
      correct: num_(att.correct), wrong: num_(att.wrong), skipped: num_(att.skipped),
      accuracy: num_(att.accuracy), section: String(att.section || '')
    },
    items: items
  };
}

/* ========================= MODEL EXAM OF THE DAY API ======================== */

/**
 * TEACHER-ONLY. Generates (or regenerates) the fixed model-exam set for a
 * target date — typically run once, the day BEFORE the exam. The system then
 * serves that SAME set, in the SAME order, to every student for the whole
 * day. Questions are chosen AUTOMATICALLY from the question bank at the
 * official MECEE-BL blueprint ratio with the CEE difficulty mix. The live
 * date cannot be replaced once somebody has taken it (score integrity).
 * @param {string} userId       teacher id
 * @param {string} sessionToken session token
 * @param {string} targetDate   'YYYY-MM-DD' ('' = tomorrow)
 * @param {number} questionCount desired size (default MODEL_DEFAULT_COUNT)
 * @param {boolean} notifyStudents email all approved students about it
 */
function generateDailyExam(userId, sessionToken, targetDate, questionCount, notifyStudents) {
  var user = requireSession_(userId, sessionToken, 'teacher');
  var today = todayStr_();
  var date = normalizeDateStr_(targetDate) || dateStrAddDays_(today, 1);
  if (!date || date < today) {
    throw new Error('Pick today or a future date — you cannot generate a model exam for a day that already passed.');
  }
  var count = Math.max(1, Math.min(100, num_(questionCount) || MODEL_DEFAULT_COUNT));
  var bank = readQuestionsWithFallback_();
  if (!bank.length) throw new Error('The question bank is empty — add questions before generating a model exam.');

  var result = withLock_(function () {
    var rows = readDailyExams_();
    var prev = findDailyRow_(rows, date);
    var participants = 0;
    if (prev) {
      participants = modelAttemptsForDate_(readTab_(TAB_ATTEMPTS), date).length;
      if (participants > 0) {
        throw new Error('MODEL_EXAM_LOCKED:' + participants + ' student' + (participants > 1 ? 's have' : ' has') + ' already taken this exam — a live model exam cannot be replaced.');
      }
    }
    var texts = writeDailyRow_(date, user.name, count, false, prev);
    return { texts: texts, replaced: !!prev, participants: participants };
  });

  /* email all approved students when requested (quota-aware) */
  var notified = 0;
  if (notifyStudents) {
    readTab_(TAB_USERS).forEach(function (u) {
      if (String(u.status) !== 'approved' || String(u.role) !== 'student') return;
      if (sendMailSafe_(String(u.email),
        APP_NAME + ' — Model exam scheduled for ' + date,
        buildModelReadyEmail_(u.name, date, result.texts.length))) notified++;
    });
  }
  sendMailSafe_(String(user.email),
    APP_NAME + ' — Model exam for ' + date + ' is ready',
    buildModelReadyEmail_(user.name, date, result.texts.length));

  return {
    success: true, date: date, questionCount: result.texts.length,
    replaced: result.replaced, notified: notified,
    generatedAt: new Date().toISOString(),
    preview: dailyPreviewItems_(readQuestionsWithFallback_(), findDailyRow_(readDailyExams_(), date))
  };
}

/** "Model exam is ready" notification email (also sent to the teacher). */
function buildModelReadyEmail_(name, date, count) {
  return '<div style="font-family:Arial,sans-serif;padding:20px">' +
    '<h3>Model exam of ' + escapeHtml_(date) + '</h3>' +
    '<p>Hi ' + escapeHtml_(name) + ',</p>' +
    '<p>A model exam with <b>' + count + ' questions</b> has been scheduled for <b>' + escapeHtml_(date) + '</b>.</p>' +
    '<p>Everyone takes the <b>same questions in the same order</b> — one attempt each, full CEE marking (+1 correct · −0.25 wrong · 0 skipped). Log in on the day and open the “Model exam of the day” card to start.</p>' +
    '<p style="color:#888;font-size:12px">' + escapeHtml_(APP_NAME) + '</p></div>';
}

/**
 * Status of the model-exam system for BOTH roles. Students see today's card
 * state (ready / taken / none) plus the daily leaderboard; teachers also get
 * tomorrow's scheduling state, a 7-day history and today's full leaderboard.
 */
function getDailyExamStatus(userId, sessionToken) {
  var user = requireSession_(userId, sessionToken);
  var today = todayStr_();
  var tomorrow = dateStrAddDays_(today, 1);
  var rows = readDailyExams_();
  var attempts = readTab_(TAB_ATTEMPTS);
  var users = readTab_(TAB_USERS);

  function brief(dateStr) {
    var r = findDailyRow_(rows, dateStr);
    if (!r || r.status !== 'ready') return { date: dateStr, ready: false };
    var parts = modelAttemptsForDate_(attempts, dateStr);
    var avg = parts.length ? Math.round(parts.reduce(function (s, a) { return s + num_(a.accuracy); }, 0) / parts.length * 10) / 10 : 0;
    var top = 0;
    parts.forEach(function (a) { if (num_(a.score) > top) top = num_(a.score); });
    return {
      date: dateStr, ready: true, questionCount: r.questionCount || r.texts.length,
      generatedBy: r.generatedBy, generatedAt: r.generatedAt, auto: r.auto,
      participants: parts.length, avgAccuracy: avg, topScore: top
    };
  }

  var isTeacher = String(user.role) === 'teacher';
  var todayBrief = brief(today);
  var payload = {
    today: todayBrief,
    tomorrow: brief(tomorrow),
    autopilot: { enabled: !!findModelTrigger_(), hour: num_(getScriptPropertyValue_('CEE_MODEL_HOUR')) || MODEL_AUTO_HOUR }
  };

  /* the logged-in student's own result for today */
  if (!isTeacher) {
    var mine = modelAttemptsForDate_(attempts.filter(function (a) {
      return String(a.userId) === String(user.id);
    }), today);
    payload.myAttempt = mine.length ? {
      score: num_(mine[0].score), total: num_(mine[0].totalQuestions),
      correct: num_(mine[0].correct), wrong: num_(mine[0].wrong), skipped: num_(mine[0].skipped),
      accuracy: num_(mine[0].accuracy), timestamp: String(mine[0].timestamp)
    } : null;
  }

  /* daily leaderboard (everyone — the whole class took the same paper) */
  var lbRows = dailyLeaderboardRows_(modelAttemptsForDate_(attempts, today), users, user.id);
  payload.leaderboard = {
    date: today, participants: lbRows.length,
    avg: lbRows.length ? Math.round(lbRows.reduce(function (s, r) { return s + r.accuracy; }, 0) / lbRows.length * 10) / 10 : 0,
    leaders: lbRows.slice(0, 10),
    myRank: (function () { var rk = 0; lbRows.forEach(function (r) { if (r.isMe) rk = r.rank; }); return rk; })()
  };

  /* 7-day history for teachers */
  if (isTeacher) {
    var hist = [];
    for (var i = 1; i <= MODEL_HISTORY_DAYS; i++) {
      var d = dateStrAddDays_(today, -i);
      var b = brief(d);
      if (b.ready) hist.push(b);
    }
    payload.history = hist;
    /* preview of the sets a teacher may want to eyeball */
    var bank = readQuestionsWithFallback_();
    var todayRow = findDailyRow_(rows, today);
    var tomorrowRow = findDailyRow_(rows, tomorrow);
    payload.todayPreview = todayRow && todayRow.status === 'ready' ? dailyPreviewItems_(bank, todayRow) : [];
    payload.tomorrowPreview = tomorrowRow && tomorrowRow.status === 'ready' ? dailyPreviewItems_(bank, tomorrowRow) : [];
  }
  return payload;
}

/**
 * STUDENT entry point for today's model exam. Returns the SAME fixed set
 * (same order) every student gets that day; one attempt per user per day.
 * The server records the start time + authoritative meta, so scoring and
 * late-submission detection are identical to the mock flow.
 */
function startDailyExam(userId, sessionToken) {
  var user = requireSession_(userId, sessionToken);
  if (String(user.role) !== 'student') {
    throw new Error('FORBIDDEN:Teachers cannot take the model exam — use “Preview questions” on the management card instead.');
  }
  var today = todayStr_();
  var row = findDailyRow_(readDailyExams_(), today);
  if (!row || row.status !== 'ready') {
    throw new Error('MODEL_NONE_TODAY:No model exam is scheduled for today. Check back tomorrow!');
  }
  var already = modelAttemptsForDate_(readTab_(TAB_ATTEMPTS).filter(function (a) {
    return String(a.userId) === String(user.id);
  }), today);
  if (already.length) {
    throw new Error('MODEL_ALREADY_TAKEN:You already took today\\u2019s model exam — your result is on the “Model exam of the day” card.');
  }
  var res = withLock_(function () {
    /* re-check inside the lock (double-click / two tabs racing) */
    var mineNow = modelAttemptsForDate_(readTab_(TAB_ATTEMPTS).filter(function (a) {
      return String(a.userId) === String(user.id);
    }), today);
    if (mineNow.length) {
      throw new Error('MODEL_ALREADY_TAKEN:You already took today\\u2019s model exam — your result is on the “Model exam of the day” card.');
    }
    var bank = readQuestionsWithFallback_();
    var resolved = resolveModelSet_(bank, row);
    if (!resolved.set.length) {
      throw new Error('MODEL_BROKEN:Today\\u2019s model exam questions were removed from the bank. Please ask your teacher to regenerate it.');
    }
    var attemptIndex = readTab_(TAB_ATTEMPTS).filter(function (a) {
      return String(a.userId) === String(user.id);
    }).length;
    var durationMs = Math.max(MIN_EXAM_MINUTES, Math.round(resolved.set.length * SECONDS_PER_QUESTION / 60)) * 60000;
    PropertiesService.getScriptProperties().setProperty(
      'CEE_EXAM_META_' + String(user.id),
      JSON.stringify({ start: Date.now(), dur: durationMs, opts: { mode: 'model', date: today }, attemptIndex: attemptIndex }));
    return { set: resolved.set, attemptIndex: attemptIndex, durationMs: durationMs };
  });
  return {
    questions: res.set.map(function (q) {
      return {
        section: q.section, topic: q.topic, question: q.question,
        A: q.A, B: q.B, C: q.C, D: q.D, image: q.image,
        difficulty: normalizeDifficulty_(q.difficulty)
      };
    }),
    questionCount: res.set.length,
    durationMinutes: Math.round(res.durationMs / 60000),
    attemptIndex: res.attemptIndex,
    startedAt: new Date().toISOString(),
    mode: 'model',
    date: today,
    participants: modelAttemptsForDate_(readTab_(TAB_ATTEMPTS), today).length
  };
}

/**
 * Daily leaderboard for a specific date (default today) — everyone answered
 * the identical paper, so scores are directly comparable.
 */
function getDailyLeaderboard(userId, sessionToken, dateStr) {
  var user = requireSession_(userId, sessionToken);
  var date = normalizeDateStr_(dateStr) || todayStr_();
  var rows = readDailyExams_();
  var row = findDailyRow_(rows, date);
  if (!row || row.status !== 'ready') throw new Error('No model exam found for ' + date + '.');
  var lbRows = dailyLeaderboardRows_(modelAttemptsForDate_(readTab_(TAB_ATTEMPTS), date), readTab_(TAB_USERS), user.id);
  return {
    date: date, questionCount: row.questionCount || row.texts.length,
    participants: lbRows.length,
    avg: lbRows.length ? Math.round(lbRows.reduce(function (s, r) { return s + r.accuracy; }, 0) / lbRows.length * 10) / 10 : 0,
    leaders: lbRows.slice(0, 10),
    myRank: (function () { var rk = 0; lbRows.forEach(function (r) { if (r.isMe) rk = r.rank; }); return rk; })()
  };
}

/**
 * TEACHER-ONLY. Enables/disables the daily autopilot: a time-driven Apps
 * Script trigger that runs every evening and generates tomorrow's model exam
 * automatically whenever one is not already scheduled — the system then
 * picks fresh questions from the bank EVERY day with zero teacher effort.
 */
function setDailyAutopilot(userId, sessionToken, enabled, hour) {
  var user = requireSession_(userId, sessionToken, 'teacher');
  var on = !!enabled;
  var h = num_(hour) || MODEL_AUTO_HOUR;
  h = Math.max(0, Math.min(23, Math.round(h)));
  var props = PropertiesService.getScriptProperties();
  if (on) {
    props.setProperty('CEE_MODEL_HOUR', String(h));
    if (!findModelTrigger_()) {
      ScriptApp.newTrigger('autoGenerateDailyExam').timeBased().everyDays(1).atHour(h).create();
    } else {
      /* hour changed → recreate the trigger with the new schedule */
      removeModelTriggers_();
      ScriptApp.newTrigger('autoGenerateDailyExam').timeBased().everyDays(1).atHour(h).create();
    }
    /* generate tomorrow's set right away so the change is visible immediately */
    autoGenerateDailyExam();
  } else {
    props.deleteProperty('CEE_MODEL_HOUR');
    removeModelTriggers_();
  }
  return { success: true, enabled: on, hour: h, by: user.name };
}

/** Finds the autopilot trigger (null when absent). */
function findModelTrigger_() {
  try {
    var triggers = ScriptApp.getProjectTriggers();
    for (var i = 0; i < triggers.length; i++) {
      if (String(triggers[i].getHandlerFunction()) === 'autoGenerateDailyExam') return triggers[i];
    }
  } catch (e) { /* preview / no auth yet */ }
  return null;
}

/** Removes every autopilot trigger. */
function removeModelTriggers_() {
  try {
    ScriptApp.getProjectTriggers().forEach(function (t) {
      if (String(t.getHandlerFunction()) === 'autoGenerateDailyExam') ScriptApp.deleteTrigger(t);
    });
  } catch (e) { /* preview / no auth yet */ }
}

/** Script-property getter that never throws. */
function getScriptPropertyValue_(key) {
  try { return PropertiesService.getScriptProperties().getProperty(key); } catch (e) { return null; }
}

/**
 * Autopilot trigger handler (runs daily, public because triggers call
 * top-level functions). Generates tomorrow's model exam only when none is
 * scheduled yet — a manual teacher generation always wins. Idempotent.
 */
function autoGenerateDailyExam() {
  var tomorrow = dateStrAddDays_(todayStr_(), 1);
  var lock = LockService.getScriptLock();
  if (!lock.tryLock(10000)) return { skipped: 'busy' };
  try {
    var rows = readDailyExams_();
    var prev = findDailyRow_(rows, tomorrow);
    if (prev && prev.status === 'ready') return { skipped: 'already-scheduled' };
    if (prev) {
      /* a cancelled/broken row with zero participants may be replaced */
      var parts = modelAttemptsForDate_(readTab_(TAB_ATTEMPTS), tomorrow);
      if (parts.length) return { skipped: 'locked' };
    }
    var bank = readQuestionsWithFallback_();
    if (!bank.length) return { skipped: 'empty-bank' };
    var texts = writeDailyRow_(tomorrow, 'System (autopilot)', MODEL_DEFAULT_COUNT, true, prev);
    console.log('Autopilot generated the model exam for ' + tomorrow + ' (' + texts.length + ' questions)');
    return { generated: true, date: tomorrow, questionCount: texts.length };
  } finally {
    lock.releaseLock();
  }
}

/* ============================== TEACHER VIEWS =============================== */

/** Pending approvals, user list, question count, attempt count, recent
 *  activity + unread in-app message count for the inbox card. */
function getTeacherStats(userId, sessionToken) {
  requireSession_(userId, sessionToken, 'teacher');
  var users = readTab_(TAB_USERS);
  function pub(u) {
    return {
      id: String(u.id), name: String(u.name), email: String(u.email),
      username: String(u.username || ''), role: String(u.role), status: String(u.status),
      createdAt: String(u.createdAt || ''), deviceLocked: !!u.deviceId
    };
  }
  var pending = users.filter(function (u) { return u.status === 'pending'; }).map(pub);
  var students = users.filter(function (u) { return u.status === 'approved'; }).map(pub);
  var questions = readTab_(TAB_QUESTIONS);
  var attempts = readTab_(TAB_ATTEMPTS);
  var unreadMessages = readTab_(TAB_MESSAGES).filter(function (m) {
    return String(m.toRole) === 'teacher' && !String(m.readAt || '').trim();
  }).length;
  var recent = attempts.slice(-20).reverse().map(function (a) {
    return {
      timestamp: String(a.timestamp), userName: String(a.userName),
      score: num_(a.score), totalQuestions: num_(a.totalQuestions), accuracy: num_(a.accuracy)
    };
  });
  return {
    stats: {
      pending: pending.length,
      students: students.length,
      questions: questions.length,
      attempts: attempts.length,
      unreadMessages: unreadMessages
    },
    pending: pending,
    students: students,
    recentAttempts: recent
  };
}

/* =========================== QUESTION MANAGEMENT ============================ */

/** Teacher-only: full question bank (capped). */
function getAllQuestions(userId, sessionToken) {
  requireSession_(userId, sessionToken, 'teacher');
  var rows = readTab_(TAB_QUESTIONS);
  if (rows.length > MAX_QUESTIONS_RETURNED) rows = rows.slice(-MAX_QUESTIONS_RETURNED);
  return rows.map(function (r) {
    return {
      section: String(r.section || ''), topic: String(r.topic || ''),
      question: String(r.question || ''),
      A: String(r.A || ''), B: String(r.B || ''), C: String(r.C || ''), D: String(r.D || ''),
      answer: String(r.answer || ''), explanation: String(r.explanation || ''),
      image: String(r.image || ''),
      difficulty: normalizeDifficulty_(r.difficulty)
    };
  });
}

function validateQuestionRow_(q) {
  if (!q) return { ok: false, error: 'Empty row.' };
  if (!String(q.question || '').trim()) return { ok: false, error: 'Missing question text.' };
  var letters = ['A', 'B', 'C', 'D'];
  for (var i = 0; i < letters.length; i++) {
    if (!String(q[letters[i]] || '').trim()) return { ok: false, error: 'Missing option ' + letters[i] + '.' };
  }
  var ans = String(q.answer || '').trim().toUpperCase();
  if (['1', '2', '3', '4'].indexOf(ans) >= 0) ans = ['A', 'B', 'C', 'D'][Number(ans) - 1];
  if (['A', 'B', 'C', 'D'].indexOf(ans) < 0) return { ok: false, error: 'Answer must be A, B, C or D.' };
  if (String(q.image || '').length > MAX_IMAGE_CHARS) {
    return { ok: false, error: 'Image too large (max ~45 KB) — compress it or use a URL.' };
  }
  return { ok: true, answer: ans, difficulty: normalizeDifficulty_(q.difficulty) };
}

function questionRowValues_(q, answer, difficulty) {
  return [
    String(q.section || '').trim() || 'General',
    String(q.topic || '').trim(),
    safeText_(String(q.question || '').trim()),
    String(q.A || '').trim(), String(q.B || '').trim(),
    String(q.C || '').trim(), String(q.D || '').trim(),
    answer,
    safeText_(String(q.explanation || '').trim()),
    String(q.image || '').trim(),
    normalizeDifficulty_(difficulty || q.difficulty)
  ];
}

/** Teacher-only: appends one question (from the form or the PDF builder). */
function addQuestion(userId, sessionToken, q) {
  requireSession_(userId, sessionToken, 'teacher');
  var v = validateQuestionRow_(q);
  if (!v.ok) throw new Error(v.error);
  return withLock_(function () {
    var key = norm_(String(q.question || ''));
    var dupe = false;
    readTab_(TAB_QUESTIONS).forEach(function (r) {
      if (!dupe && norm_(String(r.question || '')) === key) dupe = true;
    });
    if (dupe) throw new Error('DUPLICATE_QUESTION:This question text already exists in the bank. Edit it instead of adding a duplicate.');
    getSheet_(TAB_QUESTIONS).appendRow(questionRowValues_(q, v.answer, v.difficulty));
    return { success: true, message: 'Question added to the bank.' };
  });
}

/** Teacher-only: deletes a question by its exact text. */
function deleteQuestion(userId, sessionToken, questionText) {
  requireSession_(userId, sessionToken, 'teacher');
  return withLock_(function () {
    var key = norm_(questionText);
    var rows = readTab_(TAB_QUESTIONS);
    var target = null;
    rows.forEach(function (r) { if (!target && norm_(r.question) === key) target = r; });
    if (!target) throw new Error('Question not found in the bank.');
    /* guard: a question inside today's or a future model exam is locked */
    var locked = modelLockedTexts_();
    if (locked[key]) {
      throw new Error('MODEL_QUESTION_LOCKED:This question is part of today\u2019s (or an upcoming) model exam — the fixed paper must stay intact while it is live. Delete it after the exam day, or regenerate that model exam first.');
    }
    getSheet_(TAB_QUESTIONS).deleteRow(target._row);
    return { success: true, message: 'Question deleted.' };
  });
}

/** CSV parser handling quoted fields, embedded commas and newlines. */
function parseCSV_(text) {
  var rows = [], row = [], field = '', inQ = false, i = 0, c = '';
  text = String(text || '').replace(/^\uFEFF/, '');
  for (i = 0; i < text.length; i++) {
    c = text[i];
    if (inQ) {
      if (c === '"') {
        if (text[i + 1] === '"') { field += '"'; i++; }
        else inQ = false;
      } else field += c;
    } else {
      if (c === '"') inQ = true;
      else if (c === ',') { row.push(field); field = ''; }
      else if (c === '\n') { row.push(field); rows.push(row); row = []; field = ''; }
      else if (c !== '\r') field += c;
    }
  }
  if (field !== '' || row.length) { row.push(field); rows.push(row); }
  return rows.filter(function (r) { return r.some(function (x) { return String(x).trim() !== ''; }); });
}

var BULK_KEYS_ = ['section', 'topic', 'question', 'A', 'B', 'C', 'D', 'answer', 'explanation', 'image', 'difficulty'];

/** Normalizes raw bulk input (CSV text / 2D array / object array) to objects. */
function normalizeBulkRows_(raw) {
  var arr;
  if (typeof raw === 'string') arr = parseCSV_(raw);
  else if (Array.isArray(raw) && raw.length && typeof raw[0] === 'object' && !Array.isArray(raw[0])) {
    /* already an array of objects (e.g. parsed client-side) */
    return raw.map(function (o) {
      var obj = {};
      BULK_KEYS_.forEach(function (k) { obj[k] = o && o[k] !== undefined ? o[k] : ''; });
      return obj;
    });
  }
  else if (Array.isArray(raw)) arr = raw;
  else return [];

  arr = arr.filter(function (r) {
    return (r || []).some(function (x) { return String(x == null ? '' : x).trim() !== ''; });
  });
  if (!arr.length) return [];

  var first = (arr[0] || []).map(function (x) { return norm_(x).replace(/[\s_]+/g, ''); });
  var hasHeader = first.indexOf('question') >= 0;
  var out = [];
  if (hasHeader) {
    var map = {};
    var lowerKeys = {};
    BULK_KEYS_.forEach(function (k) { lowerKeys[k.toLowerCase()] = k; });
    first.forEach(function (key, idx) {
      var match = lowerKeys[key];
      if (match && map[match] === undefined) map[match] = idx;
    });
    for (var r = 1; r < arr.length; r++) {
      var obj = {};
      BULK_KEYS_.forEach(function (k) { obj[k] = map[k] === undefined ? '' : arr[r][map[k]]; });
      out.push(obj);
    }
  } else {
    arr.forEach(function (row) {
      var obj = {};
      BULK_KEYS_.forEach(function (k, idx) { obj[k] = row[idx] != null ? row[idx] : ''; });
      out.push(obj);
    });
  }
  return out;
}

/**
 * Teacher-only: bulk insert of questions, with optional DRY-RUN mode.
 * @param {string} userId
 * @param {string} sessionToken
 * @param {string|Array} csvData  CSV text, 2D array, or array of objects
 * @param {string} fileName       informational only
 * @param {boolean=} dryRun       validate only — nothing is written
 */
function bulkUploadQuestions(userId, sessionToken, csvData, fileName, dryRun) {
  requireSession_(userId, sessionToken, 'teacher');
  var rows = normalizeBulkRows_(csvData);
  var valid = [], errors = [];
  var existing = {};
  readTab_(TAB_QUESTIONS).forEach(function (r) { existing[norm_(String(r.question || ''))] = true; });
  rows.forEach(function (r, i) {
    var v = validateQuestionRow_(r);
    if (!v.ok) { errors.push('Row ' + (i + 1) + ': ' + v.error); return; }
    var key = norm_(String(r.question || ''));
    if (existing[key]) { errors.push('Row ' + (i + 1) + ': duplicate question (already in the bank)'); return; }
    existing[key] = true; /* also catch duplicates within the batch */
    valid.push(questionRowValues_(r, v.answer, v.difficulty));
  });
  if (valid.length && !dryRun) {
    withLock_(function () {
      var sh = getSheet_(TAB_QUESTIONS);
      sh.getRange(sh.getLastRow() + 1, 1, valid.length, valid[0].length).setValues(valid);
      return true;
    });
  }
  return {
    success: true,
    dryRun: !!dryRun,
    inserted: dryRun ? 0 : valid.length,
    wouldInsert: valid.length,
    skipped: errors.length,
    errors: errors.slice(0, 10),
    fileName: String(fileName || '')
  };
}

/* ========================== ANALYTICS & LEADERBOARD ========================= */

/** Subject- and micro-topic-level accuracy for the logged-in student, built
 *  from the Responses tab (with section names resolved via the question bank).
 *  weakTopics lists the lowest-accuracy topics (min 3 responses, < 70%). */
function getStudentAnalytics(userId, sessionToken) {
  var user = requireSession_(userId, sessionToken);
  var bank = {};
  readQuestionsWithFallback_().forEach(function (q) { bank[norm_(q.question)] = q; });
  var secStats = {}, topicStats = {};
  readTab_(TAB_RESPONSES).forEach(function (r) {
    if (String(r.userId) !== String(user.id)) return;
    var q = bank[norm_(r.question)] || {};
    var sec = String(q.section || '').trim() || 'General';
    var top = String(r.topic || '').trim() || String(q.topic || '').trim();
    var was = num_(r.wasCorrect);
    if (!secStats[sec]) secStats[sec] = { section: sec, correct: 0, wrong: 0, skipped: 0 };
    if (was === 1) secStats[sec].correct++;
    else if (was === -1) secStats[sec].wrong++;
    else secStats[sec].skipped++;
    if (top) {
      var k = sec + '#' + top;
      if (!topicStats[k]) topicStats[k] = { section: sec, topic: top, correct: 0, wrong: 0, skipped: 0 };
      if (was === 1) topicStats[k].correct++;
      else if (was === -1) topicStats[k].wrong++;
      else topicStats[k].skipped++;
    }
  });
  function finish(o) {
    var total = o.correct + o.wrong + o.skipped;
    o.total = total;
    o.accuracy = total ? Math.round(o.correct / total * 1000) / 10 : 0;
    return o;
  }
  var sections = Object.keys(secStats).map(function (k) { return finish(secStats[k]); });
  sections.sort(function (a, b) { return b.total - a.total; });
  var topics = Object.keys(topicStats).map(function (k) { return finish(topicStats[k]); });
  topics.sort(function (a, b) { return a.accuracy - b.accuracy || b.wrong - a.wrong; });
  return {
    sections: sections,
    weakTopics: topics.filter(function (t) { return t.total >= 3 && t.accuracy < 70; }).slice(0, 5)
  };
}

/** Top students by average accuracy (approved students only, min 1 attempt).
 *  Includes the caller's own rank even if outside the top 10. */
function getLeaderboard(userId, sessionToken) {
  var user = requireSession_(userId, sessionToken);
  var users = {};
  readTab_(TAB_USERS).forEach(function (u) {
    if (u.status === 'approved') users[String(u.id)] = u;
  });
  var agg = {};
  readTab_(TAB_ATTEMPTS).forEach(function (a) {
    var id = String(a.userId);
    var u = users[id];
    if (!u || String(u.role) !== 'student') return;
    if (!agg[id]) agg[id] = { id: id, name: String(u.name), attempts: 0, sumAcc: 0, best: 0 };
    var g = agg[id];
    g.attempts++;
    g.sumAcc += num_(a.accuracy);
    if (num_(a.score) > g.best) g.best = num_(a.score);
  });
  var rows = Object.keys(agg).map(function (k) {
    var g = agg[k];
    g.avgAccuracy = Math.round(g.sumAcc / g.attempts * 10) / 10;
    return g;
  });
  rows.sort(function (a, b) { return b.avgAccuracy - a.avgAccuracy || b.attempts - a.attempts; });
  var top = rows.slice(0, 10).map(function (r, i) {
    return {
      rank: i + 1, id: r.id, name: r.name, attempts: r.attempts,
      avgAccuracy: r.avgAccuracy, bestScore: r.best,
      isMe: String(r.id) === String(user.id)
    };
  });
  var myRank = 0;
  for (var i = 0; i < rows.length; i++) {
    if (String(rows[i].id) === String(user.id)) { myRank = i + 1; break; }
  }
  return { leaders: top, myRank: myRank, totalStudents: rows.length };
}

/* =========================== TEACHER ANALYTICS ============================== */

/** Teacher-only: class-wide performance analytics built from the Responses
 *  and Attempts tabs — subject accuracy across all students, the weakest
 *  micro-syllabus topics class-wide, and a per-student progress table. */
function getTeacherAnalytics(userId, sessionToken) {
  requireSession_(userId, sessionToken, 'teacher');
  var students = readTab_(TAB_USERS).filter(function (u) {
    return u.status === 'approved' && String(u.role) === 'student';
  });
  var bank = {};
  readQuestionsWithFallback_().forEach(function (q) { bank[norm_(q.question)] = q; });
  var attempts = readTab_(TAB_ATTEMPTS);
  var responses = readTab_(TAB_RESPONSES);

  /* ---- per-student aggregation ---- */
  var byUser = {};
  students.forEach(function (u) {
    byUser[String(u.id)] = {
      id: String(u.id), name: String(u.name), email: String(u.email),
      attempts: 0, sumAcc: 0, best: 0, lastTs: '',
      correct: 0, wrong: 0, skipped: 0, secStats: {}
    };
  });
  attempts.forEach(function (a) {
    var g = byUser[String(a.userId)];
    if (!g) return;
    g.attempts++;
    g.sumAcc += num_(a.accuracy);
    if (num_(a.score) > g.best) g.best = num_(a.score);
    var ts = String(a.timestamp || '');
    if (ts > g.lastTs) g.lastTs = ts;
  });
  responses.forEach(function (r) {
    var g = byUser[String(r.userId)];
    if (!g) return;
    var q = bank[norm_(r.question)] || {};
    var sec = String(q.section || '').trim() || 'General';
    var was = num_(r.wasCorrect);
    if (!g.secStats[sec]) g.secStats[sec] = { correct: 0, wrong: 0, skipped: 0 };
    if (was === 1) { g.correct++; g.secStats[sec].correct++; }
    else if (was === -1) { g.wrong++; g.secStats[sec].wrong++; }
    else { g.skipped++; g.secStats[sec].skipped++; }
  });
  var rows = Object.keys(byUser).map(function (k) {
    var g = byUser[k];
    var totalQ = g.correct + g.wrong + g.skipped;
    /* weakest subject with at least 3 answers */
    var weak = null, worst = 101;
    Object.keys(g.secStats).forEach(function (s) {
      var st = g.secStats[s];
      var t = st.correct + st.wrong + st.skipped;
      if (t < 3) return;
      var acc = Math.round(st.correct / t * 1000) / 10;
      if (acc < worst) { worst = acc; weak = { section: s, accuracy: acc }; }
    });
    return {
      id: g.id, name: g.name, email: g.email,
      attempts: g.attempts,
      avgAccuracy: g.attempts ? Math.round(g.sumAcc / g.attempts * 10) / 10 : 0,
      bestScore: g.best,
      answered: totalQ,
      accuracy: totalQ ? Math.round(g.correct / totalQ * 1000) / 10 : 0,
      lastActive: g.lastTs,
      weakSubject: weak
    };
  });
  rows.sort(function (a, b) { return b.avgAccuracy - a.avgAccuracy || b.attempts - a.attempts; });

  /* ---- class-wide subject + topic stats ---- */
  var secTotals = {}, topicTotals = {};
  responses.forEach(function (r) {
    var q = bank[norm_(r.question)] || {};
    var sec = String(q.section || '').trim() || 'General';
    var was = num_(r.wasCorrect);
    if (!secTotals[sec]) secTotals[sec] = { section: sec, correct: 0, wrong: 0, skipped: 0 };
    if (was === 1) secTotals[sec].correct++;
    else if (was === -1) secTotals[sec].wrong++;
    else secTotals[sec].skipped++;
    var top = String(r.topic || '').trim() || String(q.topic || '').trim();
    if (top) {
      var kk = sec + '#' + top;
      if (!topicTotals[kk]) topicTotals[kk] = { section: sec, topic: top, correct: 0, wrong: 0, skipped: 0 };
      if (was === 1) topicTotals[kk].correct++;
      else if (was === -1) topicTotals[kk].wrong++;
      else topicTotals[kk].skipped++;
    }
  });
  function finish(o) {
    var total = o.correct + o.wrong + o.skipped;
    o.total = total;
    o.accuracy = total ? Math.round(o.correct / total * 1000) / 10 : 0;
    return o;
  }
  var sections = Object.keys(secTotals).map(function (k) { return finish(secTotals[k]); });
  sections.sort(function (a, b) { return b.total - a.total; });
  var topics = Object.keys(topicTotals).map(function (k) { return finish(topicTotals[k]); });
  topics.sort(function (a, b) { return a.accuracy - b.accuracy || b.total - a.total; });

  var totCor = 0, totAll = 0;
  Object.keys(secTotals).forEach(function (k) {
    totCor += secTotals[k].correct;
    totAll += secTotals[k].correct + secTotals[k].wrong + secTotals[k].skipped;
  });
  var active = rows.filter(function (s) { return s.attempts > 0; }).length;

  return {
    overview: {
      students: students.length,
      activeStudents: active,
      participation: students.length ? Math.round(active / students.length * 100) : 0,
      attempts: attempts.length,
      avgAccuracy: totAll ? Math.round(totCor / totAll * 1000) / 10 : 0,
      questionsAnswered: totAll
    },
    sections: sections,
    weakTopics: topics.filter(function (t) { return t.total >= 3 && t.accuracy < 70; }).slice(0, 8),
    students: rows
  };
}

/** Teacher-only: full drill-down for ONE student — profile, per-subject
 *  accuracy, weakest topics and recent attempt history. */
function getStudentDetail(userId, sessionToken, targetUserId) {
  requireSession_(userId, sessionToken, 'teacher');
  var target = null;
  readTab_(TAB_USERS).forEach(function (u) {
    if (String(u.id) === String(targetUserId) && String(u.role) === 'student') target = u;
  });
  if (!target) throw new Error('Student not found.');

  var bank = {};
  readQuestionsWithFallback_().forEach(function (q) { bank[norm_(q.question)] = q; });
  var responses = readTab_(TAB_RESPONSES).filter(function (r) {
    return String(r.userId) === String(target.id);
  });
  var attempts = readTab_(TAB_ATTEMPTS).filter(function (a) {
    return String(a.userId) === String(target.id);
  }).map(function (a) {
    return {
      timestamp: String(a.timestamp), score: num_(a.score), totalQuestions: num_(a.totalQuestions),
      correct: num_(a.correct), wrong: num_(a.wrong), skipped: num_(a.skipped),
      accuracy: num_(a.accuracy), section: String(a.section || '')
    };
  });
  attempts.sort(function (x, y) { return y.timestamp.localeCompare(x.timestamp); });

  var secStats = {}, topicStats = {};
  responses.forEach(function (r) {
    var q = bank[norm_(r.question)] || {};
    var sec = String(q.section || '').trim() || 'General';
    var top = String(r.topic || '').trim() || String(q.topic || '').trim();
    var was = num_(r.wasCorrect);
    if (!secStats[sec]) secStats[sec] = { section: sec, correct: 0, wrong: 0, skipped: 0 };
    if (was === 1) secStats[sec].correct++;
    else if (was === -1) secStats[sec].wrong++;
    else secStats[sec].skipped++;
    if (top) {
      var k = sec + '#' + top;
      if (!topicStats[k]) topicStats[k] = { section: sec, topic: top, correct: 0, wrong: 0, skipped: 0 };
      if (was === 1) topicStats[k].correct++;
      else if (was === -1) topicStats[k].wrong++;
      else topicStats[k].skipped++;
    }
  });
  function finish(o) {
    var total = o.correct + o.wrong + o.skipped;
    o.total = total;
    o.accuracy = total ? Math.round(o.correct / total * 1000) / 10 : 0;
    return o;
  }
  var sections = Object.keys(secStats).map(function (k) { return finish(secStats[k]); });
  sections.sort(function (a, b) { return b.total - a.total; });
  var topics = Object.keys(topicStats).map(function (k) { return finish(topicStats[k]); });
  topics.sort(function (a, b) { return a.accuracy - b.accuracy || b.total - a.total; });

  var n = attempts.length;
  var sumAcc = attempts.reduce(function (s, a) { return s + a.accuracy; }, 0);
  return {
    profile: {
      id: String(target.id), name: String(target.name), email: String(target.email),
      username: String(target.username || ''), status: String(target.status),
      createdAt: String(target.createdAt || '')
    },
    stats: {
      attempts: n,
      avgAccuracy: n ? Math.round(sumAcc / n * 10) / 10 : 0,
      bestScore: n ? Math.max.apply(null, attempts.map(function (a) { return a.score; })) : 0,
      answered: responses.length
    },
    sections: sections,
    weakTopics: topics.filter(function (t) { return t.total >= 3 && t.accuracy < 70; }).slice(0, 5),
    attempts: attempts.slice(0, 12)
  };
}

/** Teacher-only: sends a short message email to a student via MailApp and
 *  records it in the student's in-app inbox (Messages tab). */
function sendStudentEmail(userId, sessionToken, targetUserId, message) {
  requireSession_(userId, sessionToken, 'teacher');
  var sender = null, target = null;
  var users = readTab_(TAB_USERS);
  users.forEach(function (u) {
    if (String(u.id) === String(userId)) sender = u;
    if (String(u.id) === String(targetUserId) && String(u.role) === 'student') target = u;
  });
  if (!sender) throw new Error('SESSION_INVALID:Please log in again.');
  if (!target) throw new Error('Student not found.');
  if (target.status !== 'approved') throw new Error('This student is not approved yet.');
  var msg = String(message || '').trim();
  if (!msg) throw new Error('Write a message first.');
  if (msg.length > 2000) throw new Error('Message too long (max 2000 characters).');
  var html =
    '<div style="font-family:Arial,sans-serif;max-width:560px;margin:auto;border:1px solid #e0e0e0;border-radius:10px;overflow:hidden">' +
    '<div style="background:#4f7cff;color:#fff;padding:14px 22px;font-size:17px;font-weight:bold">CEE Mock Portal</div>' +
    '<div style="padding:22px;color:#222"><h3 style="margin-top:0">A message from your teacher</h3>' +
    '<p>Hi ' + escapeHtml_(target.name) + ',</p>' +
    '<p style="white-space:pre-wrap">' + escapeHtml_(msg) + '</p>' +
    '<p style="color:#888;font-size:12px">— ' + escapeHtml_(sender.name) + '</p>' +
    '<p style="color:#888;font-size:12px;margin-top:18px">Reply to this email to contact your teacher directly, or use “Contact your teacher” in the portal.</p>' +
    '</div></div>';
  var sent = sendMailSafe_(String(target.email), APP_NAME + ' — Message from ' + sender.name, html);
  var ts = new Date().toISOString();
  withLock_(function () {
    getSheet_(TAB_MESSAGES).appendRow([
      tsCell_(ts), String(sender.id), String(sender.name), String(sender.email), 'teacher',
      String(target.id), 'student', 'Message from your teacher', safeText_(msg), ''
    ]);
    return true;
  });
  return {
    success: true,
    emailed: !!sent,
    message: sent
      ? 'Message sent to ' + target.name + ' (' + target.email + ').'
      : 'Message recorded, but the daily email quota is exhausted — the student has NOT received it.'
  };
}

/* ================================ MESSAGING ================================= */

/** Records a message row addressed to every teacher (in-app inbox). */
function recordTeacherMessage_(from, subject, body) {
  var ts = new Date().toISOString();
  getSheet_(TAB_MESSAGES).appendRow([
    tsCell_(ts), String(from.id), String(from.name), String(from.email), String(from.role),
    '', 'teacher', safeText_(subject), safeText_(body), ''
  ]);
  return ts;
}

/** Student (or teacher) → teacher in-app message. Students write their
 *  teacher; teachers writing this endpoint also land in the teacher inbox
 *  (rare, but harmless). Emails the first approved teacher (quota-safe). */
function sendStudentMessage(userId, sessionToken, subject, message) {
  var user = requireSession_(userId, sessionToken);
  if (user.status !== 'approved') throw new Error('Your account is not approved yet.');
  var subj = String(subject || '').trim();
  var msg = String(message || '').trim();
  if (!subj) throw new Error('Add a short subject first.');
  if (subj.length > 120) throw new Error('Subject too long (max 120 characters).');
  if (!msg) throw new Error('Write a message first.');
  if (msg.length > 2000) throw new Error('Message too long (max 2000 characters).');
  var teachers = readTab_(TAB_USERS).filter(function (u) {
    return String(u.role) === 'teacher' && String(u.status) === 'approved';
  });
  if (!teachers.length) throw new Error('No approved teacher account exists yet.');
  withLock_(function () {
    recordTeacherMessage_(user, subj, msg);
    return true;
  });
  /* notify the primary teacher by email (quota-aware, non-blocking) */
  var html =
    '<div style="font-family:Arial,sans-serif;max-width:560px;margin:auto;border:1px solid #e0e0e0;border-radius:10px;overflow:hidden">' +
    '<div style="background:#4f7cff;color:#fff;padding:14px 22px;font-size:17px;font-weight:bold">CEE Mock Portal</div>' +
    '<div style="padding:22px;color:#222"><h3 style="margin-top:0">Message from a student</h3>' +
    '<p><b>' + escapeHtml_(user.name) + '</b> (' + escapeHtml_(user.email) + ') sent you a message:</p>' +
    '<p style="font-size:15px;font-weight:600">' + escapeHtml_(subj) + '</p>' +
    '<p style="white-space:pre-wrap">' + escapeHtml_(msg) + '</p>' +
    '<p style="color:#888;font-size:12px;margin-top:18px">Open the teacher dashboard inbox to reply.</p></div></div>';
  var emailed = sendMailSafe_(String(teachers[0].email), APP_NAME + ' — Message from ' + user.name, html);
  return {
    success: true,
    emailed: !!emailed,
    message: emailed
      ? 'Message sent — your teacher will see it in their inbox and by email.'
      : 'Message sent — your teacher will see it in their inbox.'
  };
}

/** The logged-in user's in-app inbox. Teachers receive every row addressed
 *  to the teacher role; students receive rows addressed to them personally. */
function getInbox(userId, sessionToken) {
  var user = requireSession_(userId, sessionToken);
  var isTeacher = String(user.role) === 'teacher';
  var rows = readTab_(TAB_MESSAGES).filter(function (m) {
    if (isTeacher) return String(m.toRole) === 'teacher';
    return String(m.toRole) === 'student' && String(m.toId) === String(user.id);
  });
  rows.sort(function (x, y) { return String(y.timestamp).localeCompare(String(x.timestamp)); });
  var messages = rows.slice(0, 50).map(function (m) {
    return {
      timestamp: String(m.timestamp),
      fromId: String(m.fromId || ''),
      fromName: String(m.fromName || ''),
      fromEmail: String(m.fromEmail || ''),
      fromRole: String(m.fromRole || ''),
      subject: String(m.subject || ''),
      body: String(m.body || ''),
      read: !!String(m.readAt || '').trim()
    };
  });
  return {
    role: isTeacher ? 'teacher' : 'student',
    unread: messages.filter(function (m) { return !m.read; }).length,
    messages: messages
  };
}

/** Marks inbox rows as read. `keys` is an array of timestamps; when omitted,
 *  every unread row of the caller's own inbox is marked. */
function markInboxRead(userId, sessionToken, keys) {
  var user = requireSession_(userId, sessionToken);
  var isTeacher = String(user.role) === 'teacher';
  var want = Array.isArray(keys) ? keys.map(function (k) { return String(k); }) : null;
  var rows = readTab_(TAB_MESSAGES).filter(function (m) {
    var mine = isTeacher ? String(m.toRole) === 'teacher'
      : (String(m.toRole) === 'student' && String(m.toId) === String(user.id));
    return mine && !String(m.readAt || '').trim() && (!want || want.indexOf(String(m.timestamp)) >= 0);
  });
  if (!rows.length) return { success: true, marked: 0 };
  withLock_(function () {
    var now = new Date().toISOString();
    rows.forEach(function (m) { setCell_(TAB_MESSAGES, m._row, 'readAt', now); });
    return true;
  });
  return { success: true, marked: rows.length };
}

/* ================================ ACCOUNT ================================== */

/** Changes the logged-in user's password (verifies the current one first)
 *  and notifies them by email. */
function changePassword(userId, sessionToken, currentPassword, newPassword) {
  var user = requireSession_(userId, sessionToken);
  var oldPw = String(currentPassword || '');
  var newPw = String(newPassword || '');
  if (String(user.password) !== hashPassword(oldPw)) {
    throw new Error('Your current password is incorrect.');
  }
  if (newPw.length < 6) throw new Error('The new password must be at least 6 characters.');
  if (newPw === oldPw) throw new Error('The new password must be different from the current one.');
  withLock_(function () {
    setCell_(TAB_USERS, user._row, 'password', hashPassword(newPw));
    return true;
  });
  sendMailSafe_(String(user.email), APP_NAME + ' — Your password was changed',
    '<div style="font-family:Arial,sans-serif;max-width:560px;margin:auto;border:1px solid #e0e0e0;border-radius:10px;overflow:hidden">' +
    '<div style="background:#4f7cff;color:#fff;padding:14px 22px;font-size:17px;font-weight:bold">CEE Mock Portal</div>' +
    '<div style="padding:22px;color:#222"><h3 style="margin-top:0">Password changed</h3>' +
    '<p>Hi ' + escapeHtml_(user.name) + ', your account password was just changed. If this was not you, contact your teacher/admin immediately.</p></div></div>');
  return { success: true, message: 'Password updated. Use it on your next login.' };
}

/* ========================== QUESTION EDITING ================================ */

/** Teacher-only: updates an existing question in place (single-row update).
 *  @param {string} originalQuestionText  the exact current question text
 *  @param {Object} q                     the full new question object */
function updateQuestion(userId, sessionToken, originalQuestionText, q) {
  requireSession_(userId, sessionToken, 'teacher');
  var v = validateQuestionRow_(q);
  if (!v.ok) throw new Error(v.error);
  var original = String(originalQuestionText || '').trim();
  if (!original) throw new Error('Missing the original question text to edit.');
  return withLock_(function () {
    var rows = readTab_(TAB_QUESTIONS);
    var target = null;
    rows.forEach(function (r) { if (!target && norm_(r.question) === norm_(original)) target = r; });
    if (!target) throw new Error('Question not found in the bank.');
    /* guard: a question inside today's or a future model exam is locked
     * (renaming it would break the fixed paper students are answering) */
    var locked = modelLockedTexts_();
    if (locked[norm_(original)] || locked[norm_(String(q.question || ''))]) {
      throw new Error('MODEL_QUESTION_LOCKED:This question is part of today\u2019s (or an upcoming) model exam — the fixed paper must stay intact while it is live. Edit it after the exam day, or regenerate that model exam first.');
    }
    /* renaming to a text that already exists on ANOTHER row is a collision */
    var newKey = norm_(String(q.question || ''));
    var collision = false;
    rows.forEach(function (r) {
      if (!collision && r !== target && norm_(String(r.question || '')) === newKey) collision = true;
    });
    if (collision) throw new Error('DUPLICATE_QUESTION:Another question with this exact text already exists in the bank.');
    getSheet_(TAB_QUESTIONS)
      .getRange(target._row, 1, 1, HEADERS[TAB_QUESTIONS].length)
      .setValues([questionRowValues_(q, v.answer, v.difficulty)]);
    return { success: true, message: 'Question updated.' };
  });
}
